<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- port/platform/win/ico_pc.manifest: ico_pc.exe's application manifest,
     embedded by ico_pc.rc (docs/port/DATA.md, "Paths"; docs/port/PLATFORM.md).
     activeCodePage UTF-8 (Windows 10 1903 and later): the C library's and the
     A Win32 calls read paths as UTF-8, so the UTF-8 paths SDL_GetPrefPath and
     the ini give work even where a call was not routed through
     port/platform/host_fs.c's wide helpers. Older Windows ignore the
     element; the helpers cover them. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="ico-pc.ico_pc" version="1.0.0.0"/>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>

set(RDFX_FAILURES 0)

function(rd_fixture_list list outVar)
  if(NOT EXISTS "${list}")
    message(FATAL_ERROR "rd_fixture_list: no list ${list}")
  endif()
  file(STRINGS "${list}" lines)
  set(names "")
  foreach(l IN LISTS lines)
    string(STRIP "${l}" l)
    if(l STREQUAL "" OR l MATCHES "^#")
      continue()
    endif()
    # (one MATCHES: REGEX REPLACE's '^' matches again after each replacement
    # and would eat every word)
    set(name "${l}")
    set(rest "")
    if(l MATCHES "^([^ \t]+)[ \t]+(.*)$")
      set(name "${CMAKE_MATCH_1}")
      set(rest "${CMAKE_MATCH_2}")
    endif()
    if(name MATCHES "[/\\\\:]" OR name MATCHES "\\.\\.")
      message(FATAL_ERROR "${list}: '${name}' is a path: a list names fixtures of the repository by name")
    endif()
    set(RDFX_FIELDS_${name} "${rest}" PARENT_SCOPE)
    list(APPEND names "${name}")
  endforeach()
  if(NOT names)
    message(FATAL_ERROR "${list}: names no fixture")
  endif()
  set(${outVar} "${names}" PARENT_SCOPE)
endfunction()

function(rd_fixture_expand name dir outVar)
  if("${FIXTURE_TOOL}" STREQUAL "" OR "${FIXTURES}" STREQUAL "")
    message(FATAL_ERROR "rd_fixture_expand: the script needs -DFIXTURE_TOOL and -DFIXTURES")
  endif()
  set(fx "${FIXTURES}/${name}.rdfix")
  if(NOT EXISTS "${fx}")
    message(FATAL_ERROR "${name}: no ${fx} (a listed fixture must be in the repository)")
  endif()
  file(MAKE_DIRECTORY "${dir}")
  set(out "${dir}/${name}.rddump")
  execute_process(COMMAND "${FIXTURE_TOOL}" expand "${fx}" "${out}"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${name}: the expansion failed (exit ${rc}):\n${o}${e}")
  endif()
  string(STRIP "${o}" o)
  message(STATUS "${o}")
  set(${outVar} "${out}" PARENT_SCOPE)
endfunction()

function(rd_fixture_quantity q text outVar)
  if(NOT DEFINED _rdfx_q_${q})
    message(FATAL_ERROR "rd_fixture_quantity: no quantity '${q}' in rd_fixture_helpers.cmake's table")
  endif()
  string(REPLACE ";" "," flat "${text}")
  set(v "")
  if(flat MATCHES "${_rdfx_q_${q}}")
    set(v "${CMAKE_MATCH_1}")
  endif()
  set(${outVar} "${v}" PARENT_SCOPE)
endfunction()

function(rd_fixture_require name text)
  set(wanted ${ARGN})
  foreach(q IN LISTS wanted)
    if(NOT DEFINED _rdfx_q_${q})
      message(FATAL_ERROR "rd_fixture_require: no quantity '${q}' in rd_fixture_helpers.cmake's table")
    endif()
  endforeach()
  if(NOT DEFINED RDFX_PROPS_${name})
    execute_process(COMMAND "${FIXTURE_TOOL}" props "${FIXTURES}/${name}.rdfix"
                    RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "${name}: cannot read its properties (exit ${rc}): ${e}")
    endif()
    string(REGEX REPLACE "\n$" "" o "${o}")
    string(REPLACE "\n" ";" o "${o}")
    set(RDFX_PROPS_${name} "${o}" PARENT_SCOPE)
    set(props "${o}")
  else()
    set(props "${RDFX_PROPS_${name}}")
  endif()
  set(failures ${RDFX_FAILURES})
  set(checked 0)
  foreach(p IN LISTS props)
    if(NOT p MATCHES "^([a-z0-9_]+)(>=|<=|!=|>|<|=)(.+)$")
      message(SEND_ERROR "${name}: the property '${p}' is not QUANTITY OP VALUE")
      math(EXPR failures "${failures} + 1")
      continue()
    endif()
    set(q "${CMAKE_MATCH_1}")
    set(op "${CMAKE_MATCH_2}")
    set(want "${CMAKE_MATCH_3}")
    list(FIND wanted "${q}" at)
    if(at LESS 0)
      continue()
    endif()
    math(EXPR checked "${checked} + 1")
    rd_fixture_quantity(${q} "${text}" got)
    if(got STREQUAL "")
      message(SEND_ERROR "${name}: declares ${p}, and the replay's stats do not show ${q}")
      math(EXPR failures "${failures} + 1")
      continue()
    endif()
    set(ok FALSE)
    if(want MATCHES "^[0-9]+$" AND got MATCHES "^[0-9]+$")
      if(op STREQUAL ">=" AND got GREATER_EQUAL want)
        set(ok TRUE)
      elseif(op STREQUAL "<=" AND got LESS_EQUAL want)
        set(ok TRUE)
      elseif(op STREQUAL ">" AND got GREATER want)
        set(ok TRUE)
      elseif(op STREQUAL "<" AND got LESS want)
        set(ok TRUE)
      elseif(op STREQUAL "=" AND got EQUAL want)
        set(ok TRUE)
      elseif(op STREQUAL "!=" AND NOT got EQUAL want)
        set(ok TRUE)
      endif()
    elseif(op STREQUAL "=" AND got STREQUAL want)
      set(ok TRUE)
    elseif(op STREQUAL "!=" AND NOT got STREQUAL want)
      set(ok TRUE)
    endif()
    if(ok)
      message(STATUS "${name}: ${p} holds (${q} ${got}): the path ran")
    else()
      message(SEND_ERROR "${name}: declares ${p}, the replay shows ${q} ${got}: the fixture's "
                         "data did not take the path")
      math(EXPR failures "${failures} + 1")
    endif()
  endforeach()
  if(checked EQUAL 0)
    message(SEND_ERROR "${name}: declares none of this test's properties (${wanted}); it declares "
                       "'${props}': a fixture that carries nothing the test measures is no test")
    math(EXPR failures "${failures} + 1")
  endif()
  set(RDFX_FAILURES ${failures} PARENT_SCOPE)
endfunction()

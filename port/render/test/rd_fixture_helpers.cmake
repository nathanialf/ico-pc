# rd_fixture_helpers.cmake: what a -P test script calls to replay the committed
# fixtures (docs/port/TESTING_FIXTURES.md).  The script is given
#   -DFIXTURE_TOOL=<rd_fixture_tool> -DFIXTURES=<port/render/test/fixtures>
# and includes this file (-DFIXTURE_HELPERS=<this file>).
#
#   rd_fixture_list(LIST OUT)
#       the fixture names a list names, in order (a name a line, '#'
#       comments; the words after a name are kept in RDFX_FIELDS_<name>); a
#       line that is a path (a '/', a '\', '..', ':') FAILS: a test reads
#       nothing from outside the repository
#   rd_fixture_expand(NAME DIR OUT)
#       FIXTURES/NAME.rdfix expanded into DIR/NAME.rddump (in the build
#       tree, never committed), its SHA-256 checked by the tool; OUT the
#       dump's path.  A listed fixture that is absent or does not expand
#       to its pin FAILS
#   rd_fixture_require(NAME TEXT QUANTITY...)
#       the path ran: every property the fixture declares (expect=, the
#       tool's props) whose quantity is one of QUANTITY is checked against
#       TEXT (a replay's --stats output); a property that does not hold, a
#       quantity TEXT does not show, or a fixture that declares none of the
#       QUANTITYs is an error (SEND_ERROR), counted in RDFX_FAILURES
#   rd_fixture_quantity(NAME TEXT OUT)
#       one quantity's value in TEXT ("" when TEXT does not show it)
#
# The quantities (each the first match of its regex in the --stats lines,
# rd_replay_tool's words; add a row for a new property):
set(_rdfx_q_draws "stats: ([0-9]+) draws, [0-9]+ passes")
set(_rdfx_q_passes "stats: [0-9]+ draws, ([0-9]+) passes")
set(_rdfx_q_shadow_box_counts "shadow box on: ([0-9]+) counts and")
set(_rdfx_q_shadow_box_composites "shadow box on: [0-9]+ counts and ([0-9]+) composites")
set(_rdfx_q_shadow_box_empty "over the volumes' box \\(([0-9]+) with nothing to draw")
set(_rdfx_q_shadow_volume_draws "volume draws by date_clear_ps of ([0-9]+)")
set(_rdfx_q_shadow_count_one "shadow count: ([0-9]+) in one draw")
set(_rdfx_q_shadow_level_texels "shadow levels drawn: ([0-9]+) texels")
set(_rdfx_q_shadow_levels "shadow levels: ([0-9]+) shadows at the scene's scale")
set(_rdfx_q_date_snapshots "DATE snapshots ([0-9]+),")
set(_rdfx_q_date_stencil_draws "DATE stencil draws ([0-9]+)")
set(_rdfx_q_glow_passes "[,;] glow ([0-9]+) passes")
set(_rdfx_q_glow_plan "light plan on: ([a-z]+)")
set(_rdfx_q_glow_chains "glow blur on: ([0-9]+) chains")
set(_rdfx_q_crack_pixels "crack fill on: [0-9]+ passes, ([0-9]+) pixels filled")
set(_rdfx_q_frustum_culled "scene draws skipped \\(([0-9]+) frustum")
set(_rdfx_q_occluded "frustum, ([0-9]+) occluded")
set(_rdfx_q_vu_merge_draws "VU merge: ([0-9]+) draws in [0-9]+ runs")
set(_rdfx_q_vu_fuse_pairs "VU fuse: ([0-9]+) pairs fused")
set(_rdfx_q_prepass_vertices "VU pre-pass on: [0-9]+ passes, ([0-9]+) vertices")
set(_rdfx_q_region_rule_draws "region rule: the camera's: ([0-9]+) VU draws")
set(_rdfx_q_fades_folded "fades fold on: ([0-9]+) sprites folded")
# the shadow cuts, the no-volume window, the stencil outside the shadow window
set(_rdfx_q_date_one_shared "DATE one set-up on: ([0-9]+) shared")
set(_rdfx_q_empty_composites_skipped "empty composites on: ([0-9]+) skipped")
set(_rdfx_q_no_volume_kept "no volume on: ([0-9]+) kept")
set(_rdfx_q_no_volume_break_taken "break on: ([0-9]+) taken")
set(_rdfx_q_stencil_window_stores "stencil inside the shadow window only: ([0-9]+) stores")
# DATE's passes without the depth
set(_rdfx_q_date_cut_passes "DATE cut on: ([0-9]+) passes begun without the depth")
# the volumes' and composites' own entries, the shadow tiles, the volumes in the scene's pass
set(_rdfx_q_volume_fs_taken "volume fs on \\(self-test [^)]*\\): ([0-9]+) volume draws by date_clear_ps")
set(_rdfx_q_comp_spec_seen "composites and levels by sprite_comp_ps of ([0-9]+)")
set(_rdfx_q_comp_spec_taken "comp spec on \\(self-test [^)]*\\): ([0-9]+) composites and levels by sprite_comp_ps")
set(_rdfx_q_shadow_tile_composites "shadow tiles on: ([0-9]+) composites over the tile mask")
set(_rdfx_q_shadow_merge_counts "shadow volumes in the scene's pass on: ([0-9]+) of [0-9]+ counts")
# the glow's chain: its paste by fx_paste_ps, the lamps on WORK2's own depth, the mask folded
set(_rdfx_q_paste_spec_seen "pastes by fx_paste_ps of ([0-9]+)")
set(_rdfx_q_paste_spec_taken "paste spec on \\(self-test [^)]*\\): ([0-9]+) pastes by fx_paste_ps")
set(_rdfx_q_lamps_own_depth_draws "lamps lowres on: WORK2 [0-9]+x[0-9]+ under SCENE [0-9]+x[0-9]+, ([0-9]+) draws into WORK2 on its own depth")
set(_rdfx_q_glow_fold_folded "glow: WORK2 fold on: ([0-9]+) folded")
# the lamps' crack fill in the glow's paste pass, the present from SCENE
set(_rdfx_q_lamps_fillpaste_fills "lamps fillpaste on: ([0-9]+) crack fills drawn in the paste's pass")
set(_rdfx_q_present_scene_skipped "present from SCENE on: ([0-9]+) reductions not drawn")
# the lamps' pass area, WORK2_PAD's band left lazy, WORK0's alpha sprite owed
set(_rdfx_q_lamps_area_passes "\\): ([0-9]+) passes with the lamps' area")
set(_rdfx_q_lamps_bands_lazy "([0-9]+) bands left lazy")
set(_rdfx_q_lamps_owed "([0-9]+) WORK0 alpha sprites owed")
# the crack fill after the MSAA resolve
set(_rdfx_q_crack_msaa_fills "crack fill on: [^\n]*, ([0-9]+) fills after the MSAA resolve")

set(RDFX_FAILURES 0)

function(rd_fixture_list list outVar)
  if(NOT EXISTS "${list}")
    message(FATAL_ERROR "rd_fixture_list: no list ${list}")
  endif()
  file(STRINGS "${list}" lines)
  set(names "")
  foreach(l IN LISTS lines)
    string(STRIP "${l}" l)
    if(l STREQUAL "" OR l MATCHES "^#")
      continue()
    endif()
    # (one MATCHES: REGEX REPLACE's '^' matches again after each replacement
    # and would eat every word)
    set(name "${l}")
    set(rest "")
    if(l MATCHES "^([^ \t]+)[ \t]+(.*)$")
      set(name "${CMAKE_MATCH_1}")
      set(rest "${CMAKE_MATCH_2}")
    endif()
    if(name MATCHES "[/\\\\:]" OR name MATCHES "\\.\\.")
      message(FATAL_ERROR "${list}: '${name}' is a path: a list names fixtures of the repository by name")
    endif()
    set(RDFX_FIELDS_${name} "${rest}" PARENT_SCOPE)
    list(APPEND names "${name}")
  endforeach()
  if(NOT names)
    message(FATAL_ERROR "${list}: names no fixture")
  endif()
  set(${outVar} "${names}" PARENT_SCOPE)
endfunction()

function(rd_fixture_expand name dir outVar)
  if("${FIXTURE_TOOL}" STREQUAL "" OR "${FIXTURES}" STREQUAL "")
    message(FATAL_ERROR "rd_fixture_expand: the script needs -DFIXTURE_TOOL and -DFIXTURES")
  endif()
  set(fx "${FIXTURES}/${name}.rdfix")
  if(NOT EXISTS "${fx}")
    message(FATAL_ERROR "${name}: no ${fx} (a listed fixture must be in the repository)")
  endif()
  file(MAKE_DIRECTORY "${dir}")
  set(out "${dir}/${name}.rddump")
  execute_process(COMMAND "${FIXTURE_TOOL}" expand "${fx}" "${out}"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${name}: the expansion failed (exit ${rc}):\n${o}${e}")
  endif()
  string(STRIP "${o}" o)
  message(STATUS "${o}")
  set(${outVar} "${out}" PARENT_SCOPE)
endfunction()

function(rd_fixture_quantity q text outVar)
  if(NOT DEFINED _rdfx_q_${q})
    message(FATAL_ERROR "rd_fixture_quantity: no quantity '${q}' in rd_fixture_helpers.cmake's table")
  endif()
  string(REPLACE ";" "," flat "${text}")
  set(v "")
  if(flat MATCHES "${_rdfx_q_${q}}")
    set(v "${CMAKE_MATCH_1}")
  endif()
  set(${outVar} "${v}" PARENT_SCOPE)
endfunction()

function(rd_fixture_require name text)
  set(wanted ${ARGN})
  foreach(q IN LISTS wanted)
    if(NOT DEFINED _rdfx_q_${q})
      message(FATAL_ERROR "rd_fixture_require: no quantity '${q}' in rd_fixture_helpers.cmake's table")
    endif()
  endforeach()
  if(NOT DEFINED RDFX_PROPS_${name})
    execute_process(COMMAND "${FIXTURE_TOOL}" props "${FIXTURES}/${name}.rdfix"
                    RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "${name}: cannot read its properties (exit ${rc}): ${e}")
    endif()
    string(REGEX REPLACE "\n$" "" o "${o}")
    string(REPLACE "\n" ";" o "${o}")
    set(RDFX_PROPS_${name} "${o}" PARENT_SCOPE)
    set(props "${o}")
  else()
    set(props "${RDFX_PROPS_${name}}")
  endif()
  set(failures ${RDFX_FAILURES})
  set(checked 0)
  foreach(p IN LISTS props)
    if(NOT p MATCHES "^([a-z0-9_]+)(>=|<=|!=|>|<|=)(.+)$")
      message(SEND_ERROR "${name}: the property '${p}' is not QUANTITY OP VALUE")
      math(EXPR failures "${failures} + 1")
      continue()
    endif()
    set(q "${CMAKE_MATCH_1}")
    set(op "${CMAKE_MATCH_2}")
    set(want "${CMAKE_MATCH_3}")
    list(FIND wanted "${q}" at)
    if(at LESS 0)
      continue()
    endif()
    math(EXPR checked "${checked} + 1")
    rd_fixture_quantity(${q} "${text}" got)
    if(got STREQUAL "")
      message(SEND_ERROR "${name}: declares ${p}, and the replay's stats do not show ${q}")
      math(EXPR failures "${failures} + 1")
      continue()
    endif()
    set(ok FALSE)
    if(want MATCHES "^[0-9]+$" AND got MATCHES "^[0-9]+$")
      if(op STREQUAL ">=" AND got GREATER_EQUAL want)
        set(ok TRUE)
      elseif(op STREQUAL "<=" AND got LESS_EQUAL want)
        set(ok TRUE)
      elseif(op STREQUAL ">" AND got GREATER want)
        set(ok TRUE)
      elseif(op STREQUAL "<" AND got LESS want)
        set(ok TRUE)
      elseif(op STREQUAL "=" AND got EQUAL want)
        set(ok TRUE)
      elseif(op STREQUAL "!=" AND NOT got EQUAL want)
        set(ok TRUE)
      endif()
    elseif(op STREQUAL "=" AND got STREQUAL want)
      set(ok TRUE)
    elseif(op STREQUAL "!=" AND NOT got STREQUAL want)
      set(ok TRUE)
    endif()
    if(ok)
      message(STATUS "${name}: ${p} holds (${q} ${got}): the path ran")
    else()
      message(SEND_ERROR "${name}: declares ${p}, the replay shows ${q} ${got}: the fixture's "
                         "data did not take the path")
      math(EXPR failures "${failures} + 1")
    endif()
  endforeach()
  if(checked EQUAL 0)
    message(SEND_ERROR "${name}: declares none of this test's properties (${wanted}); it declares "
                       "'${props}': a fixture that carries nothing the test measures is no test")
    math(EXPR failures "${failures} + 1")
  endif()
  set(RDFX_FAILURES ${failures} PARENT_SCOPE)
endfunction()

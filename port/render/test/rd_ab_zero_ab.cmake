# rd_ab_zero_ab: the in-play judge's two arms of the zero-area cull
# (port/render/rd_ab.h, rd_ab_run.h; docs/port/PIPELINES.md, "The zero-area
# cull timed in play"; issue 179) give the same picture byte for byte, and
# both arms ran.  The frames: every fixture of LIST
# (port/render/test/fixtures/lists/vu_zero.txt, the zero-area cull's own:
# a fixture and the profiles it is replayed under), each expanded into
# ${OUT}/fixtures (docs/port/TESTING_FIXTURES.md).  For every frame, at each
# setting of each of its profiles, rd_replay_tool --pass-dump --stats with
# the cull on without its self-test and every entry checked
# (ICO_RD_VU_ZERO=1) five times:
#   on2   ICO_RD_AB=on, --repeat 2: every replay with the cull
#   off2  ICO_RD_AB=off, --repeat 2: every replay at the judge's off arm
#         (no entry given a word, the rule stage's build without the cull)
#   alt2  ICO_RD_AB=alt, --repeat 2: with it, then without it (the targets
#         read after the replay without it)
#   on4   ICO_RD_AB=on, --repeat 4
#   alt4  ICO_RD_AB=alt, --repeat 4: with, without, without, with (read
#         after a replay with it that followed two without)
# The profiles as rd_vu_zero_ab's (test/rd_vu_zero_ab.cmake): corpus at the
# Original 4:3 1x and the Enhanced 4:3 2x settings; mali (the Arm fakes, the
# record by compute dispatches, 1x 21:9) and mali169 (the same at 16:9).
# Every target's PNG of on2, off2 and alt2 equal byte for byte, and of on4
# and alt4.  Both arms ran: each run's judge line ("stats: A/B (alt):
# zero-area cull: N replays with it, M without") has N above 0 for on and
# alt and M above 0 for off and alt, 0 for the arm the mode leaves out; the
# cull's own line says the off arm's draws were refused for the trial
# (refused: ..., trial T with T above 0 on off2, alt2 and alt4, 0 on on2 and
# on4) and every check 0 differ; over each fixture and profile, the alt
# runs culled at least one triangle slot (the arm with it ran its test).
# MODE=stop (rd_ab_zero_stop): the way back instead: each frame once under
# its first profile's first setting with ICO_RD_AB=alt and
# ICO_RD_AB_FAKE_LOSS=1 (a device loss faked at the first replay's start),
# --repeat 4: the log must say "rd: A/B: every trial stopped for the run
# (ICO_RD_AB_FAKE_LOSS" and the judge's line "0 replays with it": every
# replay at the off arm, the cull's line its trial refusals and no slot
# culled.
# No frame here, or no device (77): SKIP.
# -DTOOL=<rd_replay_tool> -DOUT=<a folder the test may write> -DLIST=<list>
# -DFIXTURE_TOOL=... -DFIXTURES=... -DFIXTURE_HELPERS=... [-DMODE=stop]
cmake_policy(SET CMP0057 NEW) # if(... IN_LIST ...) in a -P script
cmake_policy(SET CMP0007 NEW) # an empty list field kept (rd_vu_zero_ab.cmake)
set(profiles corpus mali mali169)
set(entries "")
set(failures 0)
include("${FIXTURE_HELPERS}")
include("${CMAKE_CURRENT_LIST_DIR}/rd_fixture_list_props.cmake")
rd_fixture_list("${LIST}" fxNames)
foreach(name IN LISTS fxNames)
  string(REGEX MATCH "^[^ \t]+" prof "${RDFX_FIELDS_${name}}")
  if(NOT prof MATCHES "^[a-z0-9,]+$")
    message(SEND_ERROR "rd_ab_zero_ab: ${LIST}: ${name}: \"${prof}\" is not its profiles")
    math(EXPR failures "${failures} + 1")
    continue()
  endif()
  rd_fixture_list_props(${name})
  rd_fixture_expand(${name} "${OUT}/fixtures" dump)
  list(APPEND entries "${prof}|${dump}|${name}")
endforeach()
list(LENGTH entries nentries)
if(nentries EQUAL 0)
  if(failures GREATER 0)
    message(FATAL_ERROR "rd_ab_zero_ab: ${failures} failures, no frame replayed")
  endif()
  message(STATUS "SKIP: no frame is here")
  return()
endif()

set(env_corpus "")
set(env_mali ICO_VK_FAKE_LIMITS=mali ICO_VK_FAKE_VENDOR=0x13B5 ICO_RD_VU_RECORD=compute)
set(env_mali169 ${env_mali})
set(settings_corpus orig enh43)
set(settings_mali mali)
set(settings_mali169 m169)
set(args_orig --aspect 4:3)
set(args_enh43 --enhanced --aspect 4:3 --resolution 2x)
set(args_mali --aspect 21:9)
set(args_m169 --aspect 16:9)
set(useRe "stats: VU pre-pass on: [1-9]")
# the cull's run line (rd_vu_zero_run.c rd__vu_zero_stats_text), matched in
# the run's text with its ';' made ','
set(cullNumRe "VU zero-area cull on [^:]*: ([0-9]+) of ([0-9]+) triangle slots culled over [0-9]+ pictures checked, ([0-9]+) differ, [0-9]+ draws culling \\([0-9]+ triangles, [0-9]+ shared lists given up\\), refused: ([a-z0-9 ,]*), zero-area modules made")
# the judge's line (rd_ab.c rd_ab_stats_text)
set(abRe "stats: A/B \\(([a-z ]+)\\): zero-area cull: ([0-9]+) replays with it, ([0-9]+) without")

# run R of a frame: rc, its text flattened, the cull's culled slots, differ
# and trial refusals, the judge's replays with and without the cull
function(abRun dump p s mode repeat dir extra)
  file(REMOVE_RECURSE "${dir}")
  file(MAKE_DIRECTORY "${dir}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${env_${p}} ICO_RD_VU_ZERO=1
                          ICO_RD_AB=${mode} ${extra} "${TOOL}" "${dump}" /dev/null
                          --pass-dump "${dir}" --stats --repeat ${repeat} ${args_${s}}
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  string(REPLACE ";" "," flat "${out}\n${err}")
  set(culled -1)
  set(differ -1)
  set(trial -1)
  if(flat MATCHES "${cullNumRe}")
    set(culled "${CMAKE_MATCH_1}")
    set(differ "${CMAKE_MATCH_3}")
    set(refused "${CMAKE_MATCH_4}")
    set(trial 0)
    if(refused MATCHES "trial ([0-9]+)")
      set(trial "${CMAKE_MATCH_1}")
    endif()
  endif()
  set(with -1)
  set(without -1)
  if(flat MATCHES "${abRe}")
    set(with "${CMAKE_MATCH_2}")
    set(without "${CMAKE_MATCH_3}")
  endif()
  set(r_rc "${rc}" PARENT_SCOPE)
  set(r_flat "${flat}" PARENT_SCOPE)
  set(r_err "${err}" PARENT_SCOPE)
  set(r_culled "${culled}" PARENT_SCOPE)
  set(r_differ "${differ}" PARENT_SCOPE)
  set(r_trial "${trial}" PARENT_SCOPE)
  set(r_with "${with}" PARENT_SCOPE)
  set(r_without "${without}" PARENT_SCOPE)
endfunction()

if(MODE STREQUAL "stop")
  set(stops 0)
  foreach(e IN LISTS entries)
    string(REPLACE "|" ";" ef "${e}")
    list(GET ef 0 prof)
    list(GET ef 1 dump)
    string(REPLACE "," ";" profList "${prof}")
    list(GET profList 0 p)
    list(GET settings_${p} 0 s)
    abRun("${dump}" ${p} ${s} alt 4 "${OUT}/stop" "ICO_RD_AB_FAKE_LOSS=1")
    if(r_rc EQUAL 77)
      message(STATUS "SKIP: no device: ${r_err}")
      return()
    endif()
    if(NOT r_rc EQUAL 0)
      message(SEND_ERROR "${dump}: exit ${r_rc}:\n${r_err}")
      math(EXPR failures "${failures} + 1")
    elseif(NOT r_flat MATCHES "rd: A/B: every trial stopped for the run \\(ICO_RD_AB_FAKE_LOSS"
           OR NOT r_with EQUAL 0 OR NOT r_without GREATER 0 OR NOT r_trial GREATER 0
           OR NOT r_culled EQUAL 0)
      message(SEND_ERROR "${dump}: the way back not taken (stop line, ${r_with} with and ${r_without} without, ${r_trial} trial refusals, ${r_culled} culled):\n${r_flat}")
      math(EXPR failures "${failures} + 1")
    else()
      math(EXPR stops "${stops} + 1")
    endif()
  endforeach()
  math(EXPR failures "${failures} + ${RDFX_FAILURES}")
  message(STATUS "rd_ab_zero_stop: the way back taken on ${stops} of ${nentries} frames")
  if(failures GREATER 0)
    message(FATAL_ERROR "rd_ab_zero_stop: ${failures} failures")
  endif()
  return()
endif()

# the runs, what each mode's judge line and trial refusals must say
set(runs on2 off2 alt2 on4 alt4)
set(mode_on2 on)
set(mode_off2 off)
set(mode_alt2 alt)
set(mode_on4 on)
set(mode_alt4 alt)
set(rep_on2 2)
set(rep_off2 2)
set(rep_alt2 2)
set(rep_on4 4)
set(rep_alt4 4)
set(compared 0)
set(index 0)
foreach(p IN LISTS profiles)
  set(compared_${p} 0)
  set(asked_${p} 0)
endforeach()
foreach(e IN LISTS entries)
  string(REPLACE "|" ";" ef "${e}")
  list(GET ef 0 prof)
  list(GET ef 1 dump)
  list(GET ef 2 name)
  string(REPLACE "," ";" profList "${prof}")
  list(REMOVE_DUPLICATES profList)
  foreach(p IN LISTS profList)
    set(asked_${p} 1)
    set(fxPairs 0)
    set(altCulled 0)
    foreach(s IN LISTS settings_${p})
      math(EXPR index "${index} + 1")
      set(ok TRUE)
      foreach(r IN LISTS runs)
        set(dir_${r} "${OUT}/${index}-${p}-${s}-${r}")
        abRun("${dump}" ${p} ${s} ${mode_${r}} ${rep_${r}} "${dir_${r}}" "")
        if(r_rc EQUAL 77)
          message(STATUS "SKIP: no device: ${r_err}")
          return()
        endif()
        if(NOT r_rc EQUAL 0 AND "${r_err}" MATCHES "cannot show")
          message(STATUS "${dump} ${p} ${s}: skipped (${r_err})")
          set(ok FALSE)
          break()
        endif()
        if(r_rc EQUAL 0 AND NOT r_flat MATCHES "${useRe}")
          message(STATUS "${dump} ${p} ${s}: skipped (nothing drawn through the record)")
          set(ok FALSE)
          break()
        endif()
        if(NOT r_rc EQUAL 0)
          message(SEND_ERROR "${dump} ${p} ${s} ${r}: exit ${r_rc}:\n${r_err}")
          math(EXPR failures "${failures} + 1")
          set(ok FALSE)
          break()
        endif()
        message(STATUS "${dump} ${p} ${s} ${r}: ${r_with} replays with the cull, ${r_without} without; ${r_culled} slots culled, ${r_trial} draws refused for the trial, ${r_differ} differ")
        # the arms the mode asks for ran, and only those
        if(mode_${r} STREQUAL "on")
          set(armsOk FALSE)
          if(r_with GREATER 0 AND r_without EQUAL 0 AND r_trial EQUAL 0)
            set(armsOk TRUE)
          endif()
        elseif(mode_${r} STREQUAL "off")
          set(armsOk FALSE)
          if(r_with EQUAL 0 AND r_without GREATER 0 AND r_trial GREATER 0 AND r_culled EQUAL 0)
            set(armsOk TRUE)
          endif()
        else()
          set(armsOk FALSE)
          if(r_with GREATER 0 AND r_without GREATER 0 AND r_trial GREATER 0)
            set(armsOk TRUE)
          endif()
          math(EXPR altCulled "${altCulled} + ${r_culled}")
        endif()
        if(NOT armsOk)
          message(SEND_ERROR "${dump} ${p} ${s} ${r}: the arms of ICO_RD_AB=${mode_${r}} did not run as asked (${r_with} replays with the cull, ${r_without} without, ${r_trial} draws refused for the trial, ${r_culled} culled):\n${r_flat}")
          math(EXPR failures "${failures} + 1")
        endif()
        if(NOT r_differ EQUAL 0)
          message(SEND_ERROR "${dump} ${p} ${s} ${r}: the cull's checks: ${r_differ} differ (or no cull line)")
          math(EXPR failures "${failures} + 1")
        endif()
      endforeach()
      if(NOT ok)
        continue()
      endif()
      # the pictures: on2 = off2 = alt2, on4 = alt4, every target
      set(n 0)
      foreach(pair "on2;off2" "on2;alt2" "on4;alt4")
        list(GET pair 0 a)
        list(GET pair 1 b)
        file(GLOB pngs RELATIVE "${dir_${a}}" "${dir_${a}}/*.png")
        file(GLOB pngsB RELATIVE "${dir_${b}}" "${dir_${b}}/*.png")
        foreach(need SCENE.png DISPLAY.png)
          if(NOT need IN_LIST pngs)
            message(SEND_ERROR "${dump} ${p} ${s} ${a}: no ${need} written")
            math(EXPR failures "${failures} + 1")
          endif()
        endforeach()
        foreach(png IN LISTS pngs)
          if(NOT png IN_LIST pngsB)
            message(SEND_ERROR "${dump} ${p} ${s}: ${png} written by ${a} alone")
            math(EXPR failures "${failures} + 1")
            continue()
          endif()
          execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${dir_${a}}/${png}"
                                  "${dir_${b}}/${png}" RESULT_VARIABLE same)
          if(NOT same EQUAL 0)
            message(SEND_ERROR "${dump} ${p} ${s}: ${png} differs between ${a} and ${b}")
            math(EXPR failures "${failures} + 1")
          endif()
          math(EXPR n "${n} + 1")
        endforeach()
        foreach(png IN LISTS pngsB)
          if(NOT png IN_LIST pngs)
            message(SEND_ERROR "${dump} ${p} ${s}: ${png} written by ${b} alone")
            math(EXPR failures "${failures} + 1")
          endif()
        endforeach()
      endforeach()
      math(EXPR compared "${compared} + ${n}")
      math(EXPR compared_${p} "${compared_${p}} + ${n}")
      if(n GREATER 0)
        math(EXPR fxPairs "${fxPairs} + 1")
      endif()
      message(STATUS "${dump} ${p} ${s}: ${n} targets compared")
      if(failures EQUAL 0)
        foreach(r IN LISTS runs)
          file(REMOVE_RECURSE "${dir_${r}}")
        endforeach()
      endif()
    endforeach()
    if(fxPairs EQUAL 0)
      message(SEND_ERROR "${name}: nothing compared under the ${p} profile")
      math(EXPR failures "${failures} + 1")
    elseif(NOT altCulled GREATER 0)
      message(SEND_ERROR "${name} ${p}: the alternating runs culled no triangle slot: the arm with the cull did not run its test")
      math(EXPR failures "${failures} + 1")
    endif()
  endforeach()
endforeach()
foreach(p IN LISTS profiles)
  if(asked_${p} AND compared_${p} EQUAL 0)
    message(SEND_ERROR "rd_ab_zero_ab: no target compared under the ${p} profile")
    math(EXPR failures "${failures} + 1")
  endif()
endforeach()
math(EXPR failures "${failures} + ${RDFX_FAILURES}")
message(STATUS "rd_ab_zero_ab: ${compared} targets compared over ${nentries} frames (corpus ${compared_corpus}, mali ${compared_mali}, mali169 ${compared_mali169})")
if(failures GREATER 0)
  message(FATAL_ERROR "rd_ab_zero_ab: ${failures} failures")
endif()

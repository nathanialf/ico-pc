# rd_vis_hiz_corpus: the occlusion test's cheaper collect (rd_vis_hiz.c
# rd__vis_hiz_mesh_ex, rd_vis_hiz_fast.c, rd_vis.c hizCollect; docs/port/RENDER.md,
# "Culling", the occlusion test's cost) never changes a verdict, over the
# occlusion corpus.  For every row of TABLE (test/rd_vis_hiz_corpus.txt: a
# setting, a dump of tools/occlusion_corpus.txt and the 26 counts the plain
# pass made) whose dump is here, rd_replay_tool --cull full --stats under
# ICO_RD_BLEND=fixed twice: with ICO_RD_CULL_HIZ_FAST=0 (the plain pass) and
# with the fast collect and ICO_RD_CULL_HIZ_CHECK=1 (every triangle it leaves
# and every cache hit done in full as well).  The fast run's counts ("stats:
# cull full:" and "stats: cull occlusion:") must equal the plain run's and the
# table's, and its "check: N checked, W wrong" must say W = 0; the plain run
# equal to the table but not the fast one is the fast path's fault, both apart
# from the table a change of the rules (the table to be made again).  Each
# row's collect time of both runs is printed, and their sums.  No dump here,
# or no device: SKIP (77).  -DTOOL=<rd_replay_tool> -DTABLE=<the table>
# -DOUT=<a folder the test may write>
if(NOT EXISTS "${TABLE}")
  message(FATAL_ERROR "${TABLE}: no table")
endif()
file(STRINGS "${TABLE}" lines)
set(args_orig43 --aspect 4:3 --present 640x480)
set(args_enh2x43 --enhanced --aspect 4:3 --resolution 2x)
set(args_enh2x43r3 --enhanced --aspect 4:3 --resolution 2x --repeat 3)
# (CMake keeps nine groups: the line in two)
set(cullRe "stats: cull full: ([0-9]+) of ([0-9]+) scene draws skipped \\(([0-9]+) frustum, ([0-9]+) occluded\\), ([0-9.]+) ms,")
set(hizRe "stats: cull full: [^\n]*occlusion: ([0-9]+) occluder triangles \\(([0-9]+) past the budget\\), ([0-9]+) cells, ([0-9]+) draws tested, ([0-9]+) resets, ([0-9.]+) ms")
set(costRe "stats: cull occlusion cost: collect ([0-9.]+) ms \\(settle ([0-9.]+),[^\n]*fast (on|off), check: ([0-9]+) checked, ([0-9]+) wrong")
set(rows 0)
set(failures 0)
set(checkedTotal 0)
set(plainCull 0)
set(fastCull 0)
set(plainHiz 0)
set(fastHiz 0)
foreach(l IN LISTS lines)
  string(STRIP "${l}" l)
  if(l STREQUAL "" OR l MATCHES "^#")
    continue()
  endif()
  if(NOT l MATCHES "^([a-z0-9]+) ([^ ]+) (.*)$")
    message(SEND_ERROR "${TABLE}: a row not read: ${l}")
    math(EXPR failures "${failures} + 1")
    continue()
  endif()
  set(setting "${CMAKE_MATCH_1}")
  set(dump "${CMAKE_MATCH_2}")
  set(want "${CMAKE_MATCH_3}")
  if(NOT EXISTS "${dump}")
    message(STATUS "${dump}: no such dump, skipped")
    continue()
  endif()
  if(NOT DEFINED args_${setting})
    message(SEND_ERROR "${TABLE}: setting ${setting} unknown")
    math(EXPR failures "${failures} + 1")
    continue()
  endif()
  set(got_plain "")
  set(got_fast "")
  foreach(run plain fast)
    if(run STREQUAL "plain")
      set(env ICO_RD_CULL_HIZ_FAST=0)
    else()
      set(env ICO_RD_CULL_HIZ_CHECK=1)
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env ICO_RD_BLEND=fixed ${env}
                            "${TOOL}" "${dump}" - --cull full --stats ${args_${setting}}
                    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(rc EQUAL 77)
      message(STATUS "SKIP: no device: ${err}")
      return()
    endif()
    # the tool's lines with their ";" taken out (a ";" would split a list item)
    string(REPLACE ";" "," out "${out}")
    if(NOT rc EQUAL 0 OR NOT out MATCHES "${cullRe}")
      message(SEND_ERROR "${dump} ${setting} ${run}: exit ${rc}, the stats line not read:\n${err}")
      math(EXPR failures "${failures} + 1")
      set(got_${run} "")
      continue()
    endif()
    set(got "${CMAKE_MATCH_1} ${CMAKE_MATCH_2} ${CMAKE_MATCH_3} ${CMAKE_MATCH_4}")
    set(cullMs_${run} "${CMAKE_MATCH_5}")
    if(NOT out MATCHES "${hizRe}")
      message(SEND_ERROR "${dump} ${setting} ${run}: the stats line's occlusion part not read")
      math(EXPR failures "${failures} + 1")
      set(got_${run} "")
      continue()
    endif()
    string(APPEND got " ${CMAKE_MATCH_1} ${CMAKE_MATCH_2} ${CMAKE_MATCH_3} ${CMAKE_MATCH_4} ${CMAKE_MATCH_5}")
    set(hizMs_${run} "${CMAKE_MATCH_6}")
    # the 17 reasons of "stats: cull occlusion:", in order
    if(NOT out MATCHES "stats: cull occlusion:([^\n]*)")
      message(SEND_ERROR "${dump} ${setting} ${run}: no occlusion reasons line")
      math(EXPR failures "${failures} + 1")
      set(got_${run} "")
      continue()
    endif()
    string(REGEX MATCHALL " [0-9]+(,|$)" nums "${CMAKE_MATCH_1}")
    foreach(n IN LISTS nums)
      string(REGEX REPLACE "[ ,]" "" n "${n}")
      string(APPEND got " ${n}")
    endforeach()
    set(got_${run} "${got}")
    if(NOT out MATCHES "${costRe}")
      message(SEND_ERROR "${dump} ${setting} ${run}: no occlusion cost line")
      math(EXPR failures "${failures} + 1")
      continue()
    endif()
    set(collect_${run} "${CMAKE_MATCH_1}")
    set(fastOn "${CMAKE_MATCH_3}")
    set(checked "${CMAKE_MATCH_4}")
    set(wrong "${CMAKE_MATCH_5}")
    if(run STREQUAL "plain" AND NOT fastOn STREQUAL "off")
      message(SEND_ERROR "${dump} ${setting}: ICO_RD_CULL_HIZ_FAST=0 not taken (fast ${fastOn})")
      math(EXPR failures "${failures} + 1")
    endif()
    if(run STREQUAL "fast")
      if(NOT fastOn STREQUAL "on")
        message(SEND_ERROR "${dump} ${setting}: the fast collect off by default")
        math(EXPR failures "${failures} + 1")
      endif()
      if(NOT wrong EQUAL 0)
        message(SEND_ERROR "${dump} ${setting}: the check found ${wrong} of ${checked} wrong")
        math(EXPR failures "${failures} + 1")
      endif()
      math(EXPR checkedTotal "${checkedTotal} + ${checked}")
    endif()
  endforeach()
  if(got_plain STREQUAL "" OR got_fast STREQUAL "")
    continue()
  endif()
  math(EXPR rows "${rows} + 1")
  if(NOT got_fast STREQUAL got_plain)
    message(SEND_ERROR "${dump} ${setting}: the fast collect's counts differ from the plain "
                       "pass's:\n  plain: ${got_plain}\n  fast:  ${got_fast}")
    math(EXPR failures "${failures} + 1")
  elseif(NOT "${want}" STREQUAL "${got_fast}")
    message(SEND_ERROR "${dump} ${setting}: both passes differ from the table (a change of the "
                       "rules? the table is made by the plain pass):\n  table:  ${want}\n"
                       "  passes: ${got_fast}")
    math(EXPR failures "${failures} + 1")
  endif()
  message(STATUS "${dump} ${setting}: counts ${got_fast}; cull ${cullMs_plain} -> ${cullMs_fast} "
                 "ms, occlusion ${hizMs_plain} -> ${hizMs_fast} ms, collect ${collect_plain} -> "
                 "${collect_fast} ms")
  # the sums in microseconds (math is integer)
  foreach(v cullMs_plain cullMs_fast hizMs_plain hizMs_fast)
    string(REGEX REPLACE "\\.([0-9][0-9][0-9]).*$" "\\1" us_${v} "${${v}}")
    string(REGEX REPLACE "^0+([0-9])" "\\1" us_${v} "${us_${v}}")
  endforeach()
  math(EXPR plainCull "${plainCull} + ${us_cullMs_plain}")
  math(EXPR fastCull "${fastCull} + ${us_cullMs_fast}")
  math(EXPR plainHiz "${plainHiz} + ${us_hizMs_plain}")
  math(EXPR fastHiz "${fastHiz} + ${us_hizMs_fast}")
endforeach()
if(rows EQUAL 0)
  message(STATUS "SKIP: no dump of ${TABLE} is here")
  return()
endif()
set(sums "the sums over the rows: cull ${plainCull} -> ${fastCull} us, occlusion ${plainHiz} -> ${fastHiz} us (plain -> fast; neither occlusion figure holds the settle)")
if(failures GREATER 0)
  message(FATAL_ERROR "rd_vis_hiz_corpus: ${failures} failure(s) over ${rows} rows; ${sums}")
endif()
message(STATUS "rd_vis_hiz_corpus: ${rows} rows, the same counts with the fast collect as with "
               "the plain pass and the table; ${checkedTotal} triangles and cache hits checked "
               "in full, none wrong; ${sums}")

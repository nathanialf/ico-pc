# rd_vu_flat0_ab: the main vertex shader's flat outputs at the provoking
# corner (port/shaders/vu_tri.hlsl vu_main_vs, ICO_VU_FLAT0;
# port/render/rd_vu_flat0.h; docs/port/PIPELINES.md, "Flat outputs at the
# provoking corner") against the twins with every corner computing them
# (ICO_RD_VU_FLAT0=0: vu_all_main_vs, vu_merge_all_main_vs, the shader of
# v0.11.5), byte for byte.  For every dump LIST names (tools/vu_flat0_dumps.txt:
# each line the profiles it is replayed under, then the path) and DUMP (one
# more file, may be absent: the corpus profile), rd_replay_tool --pass-dump
# with --stats twice, ICO_RD_VU_FLAT0=0 and =1, at each setting of each of its
# profiles, each with the draw merge (the merge build vu_merge_main_vs) and
# without it (ICO_RD_VU_MERGE=0: vu_main_vs a draw):
#   corpus  the device as it is: the Original preset at 4:3 and 1x, and the
#           Enhanced preset at 16:9 and 2x
#   mali    issue 179's Mali-G52 on lavapipe: the Arm fakes
#           (ICO_VK_FAKE_LIMITS=mali, ICO_VK_FAKE_VENDOR=0x13B5), the record
#           by compute dispatches as on that phone (ICO_RD_VU_RECORD=compute),
#           its settings: 1x, 21:9, half height
#   pixel   the Pixel 10 Pro Fold's (ICO_VK_FAKE_LIMITS=moltenvk, Enhanced at
#           2364x1080, full height, full pixel, presented at 2364x1080)
# With BACKEND other than vulkan (the OpenGL twin, Direct3D 11 on CI's WARP)
# every dump takes the corpus settings alone (the fakes are Vulkan's).
# Every target's PNG (SCENE and DISPLAY among them) must be equal byte for
# byte; the =0 run must say "rd: VU flat outputs: every corner" and the =1
# run "rd: VU flat outputs: provoking corner only (9 loads a corner-0
# invocation, 4 at the others"; the merged runs "merge on)", the others
# "merge off)".  A dump whose =0 run draws nothing through the record (no
# "stats: VU pre-pass on: [1-9]" line: a 2D-only frame) is skipped at that
# setting, as is a 4:3 frame the 16:9 setting cannot show; every profile
# with a dump here must have compared targets.  Where /primary/dev/ico-dumps
# exists, a listed dump that is absent (a glob that matches nothing) fails;
# elsewhere it is reported and skipped.  No dump here, or no device (77):
# SKIP.
# -DTOOL=<rd_replay_tool> -DOUT=<a folder the test may write> [-DLIST=<list>]
# [-DDUMP=<dump>] [-DBACKEND=vulkan|opengl|d3d11 (default vulkan)]
cmake_policy(SET CMP0057 NEW) # if(... IN_LIST ...) in a -P script
if(NOT BACKEND)
  set(BACKEND vulkan)
endif()
set(strict FALSE)
if(EXISTS "/primary/dev/ico-dumps")
  set(strict TRUE)
endif()
set(profiles corpus mali pixel)
set(entries "")
set(failures 0)
set(missing 0)
if(DUMP AND EXISTS "${DUMP}")
  list(APPEND entries "corpus|${DUMP}")
endif()
if(LIST)
  if(NOT EXISTS "${LIST}")
    if(strict)
      message(SEND_ERROR "rd_vu_flat0_ab: ${LIST}: no dump list")
      math(EXPR failures "${failures} + 1")
    else()
      message(STATUS "rd_vu_flat0_ab: ${LIST}: no dump list, skipped")
    endif()
  else()
    get_filename_component(listDir "${LIST}" DIRECTORY)
    file(STRINGS "${LIST}" lines)
    foreach(l IN LISTS lines)
      string(STRIP "${l}" l)
      if(l STREQUAL "" OR l MATCHES "^#")
        continue()
      endif()
      if(NOT l MATCHES "^([a-z,]+)[ \t]+(.+)$")
        message(SEND_ERROR "rd_vu_flat0_ab: ${LIST}: \"${l}\" is not \"profiles path\"")
        math(EXPR failures "${failures} + 1")
        continue()
      endif()
      set(prof "${CMAKE_MATCH_1}")
      set(path "${CMAKE_MATCH_2}")
      string(REPLACE "," ";" profList "${prof}")
      foreach(p IN LISTS profList)
        if(NOT p IN_LIST profiles)
          message(SEND_ERROR "rd_vu_flat0_ab: ${LIST}: \"${p}\" is none of ${profiles}")
          math(EXPR failures "${failures} + 1")
        endif()
      endforeach()
      if(NOT IS_ABSOLUTE "${path}")
        set(path "${listDir}/${path}")
      endif()
      set(found "")
      if(path MATCHES "[*]")
        file(GLOB found "${path}")
        list(SORT found)
      elseif(EXISTS "${path}")
        set(found "${path}")
      endif()
      if(NOT found)
        math(EXPR missing "${missing} + 1")
        if(strict)
          message(SEND_ERROR "rd_vu_flat0_ab: ${LIST} names ${path}, which is not here")
          math(EXPR failures "${failures} + 1")
        else()
          message(STATUS "rd_vu_flat0_ab: ${LIST} names ${path}, which is not here: skipped")
        endif()
        continue()
      endif()
      foreach(f IN LISTS found)
        list(APPEND entries "${prof}|${f}")
      endforeach()
    endforeach()
  endif()
endif()
list(LENGTH entries nentries)
if(nentries EQUAL 0)
  if(failures GREATER 0)
    message(FATAL_ERROR "rd_vu_flat0_ab: ${failures} failures, no dump replayed")
  endif()
  message(STATUS "SKIP: no dump is here")
  return()
endif()

set(env_corpus "")
set(env_mali ICO_VK_FAKE_LIMITS=mali ICO_VK_FAKE_VENDOR=0x13B5 ICO_RD_VU_RECORD=compute)
set(env_pixel ICO_VK_FAKE_LIMITS=moltenvk)
set(settings_corpus orig enh169)
set(settings_mali mali)
set(settings_pixel pixel)
set(args_orig --aspect 4:3)
set(args_enh169 --enhanced --aspect 16:9 --resolution 2x)
set(args_mali --aspect 21:9)
set(args_pixel --enhanced --resolution 2364x1080 --full-height --full-pixel --present 2364x1080)
set(merges merge nomerge)
set(env_merge "")
set(env_nomerge ICO_RD_VU_MERGE=0)
set(req_merge "merge on\\)")
set(req_nomerge "merge off\\)")
set(reqOff "rd: VU flat outputs: every corner")
set(reqOn "rd: VU flat outputs: provoking corner only \\(9 loads a corner-0 invocation, 4 at the others")
set(useRe "stats: VU pre-pass on: [1-9]")
foreach(p IN LISTS profiles)
  set(asked_${p} 0)
  set(compared_${p} 0)
endforeach()
set(compared 0)
set(index 0)
foreach(e IN LISTS entries)
  string(REGEX REPLACE "\\|.*$" "" prof "${e}")
  string(REGEX REPLACE "^[^|]*\\|" "" dump "${e}")
  string(REPLACE "," ";" profList "${prof}")
  if(NOT BACKEND STREQUAL "vulkan")
    set(profList corpus)
  endif()
  list(REMOVE_DUPLICATES profList)
  foreach(p IN LISTS profList)
    set(asked_${p} 1)
    foreach(s IN LISTS settings_${p})
      foreach(m IN LISTS merges)
        math(EXPR index "${index} + 1")
        set(dirA "${OUT}/${index}-${p}-${s}-${m}-every")
        set(dirB "${OUT}/${index}-${p}-${s}-${m}-first")
        file(REMOVE_RECURSE "${dirA}" "${dirB}")
        file(MAKE_DIRECTORY "${dirA}" "${dirB}")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${env_${p}} ${env_${m}}
                                ICO_RD_VU_FLAT0=0 "${TOOL}" "${dump}" /dev/null
                                --pass-dump "${dirA}" --stats ${args_${s}}
                        RESULT_VARIABLE rcA OUTPUT_VARIABLE outA ERROR_VARIABLE errA)
        if(rcA EQUAL 77)
          message(STATUS "SKIP: no device: ${errA}")
          return()
        endif()
        if(NOT rcA EQUAL 0 AND "${errA}" MATCHES "cannot show")
          message(STATUS "${dump} ${p} ${s} ${m}: skipped (${errA})")
          continue()
        endif()
        string(REPLACE ";" "," flatA "${outA}\n${errA}")
        if(rcA EQUAL 0 AND NOT flatA MATCHES "${useRe}")
          message(STATUS "${dump} ${p} ${s} ${m}: skipped (nothing drawn through the record)")
          continue()
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${env_${p}} ${env_${m}}
                                ICO_RD_VU_FLAT0=1 "${TOOL}" "${dump}" /dev/null
                                --pass-dump "${dirB}" --stats ${args_${s}}
                        RESULT_VARIABLE rcB OUTPUT_VARIABLE outB ERROR_VARIABLE errB)
        if(NOT rcA EQUAL 0 OR NOT rcB EQUAL 0)
          message(SEND_ERROR "${dump} ${p} ${s} ${m}: exit ${rcA} (=0) and ${rcB} (=1):\n${errA}\n${errB}")
          math(EXPR failures "${failures} + 1")
          continue()
        endif()
        string(REPLACE ";" "," flatB "${outB}\n${errB}")
        # the Direct3D 11 debug layer's findings (tools/ci_d3d11_warp.sh runs
        # this script on WARP with ICO_D3D11_DEBUG=1)
        if("${errA}${errB}" MATCHES "rhi_d3d11 debug (error|corruption)[^\n]*")
          message(SEND_ERROR "${dump} ${p} ${s} ${m}: ${CMAKE_MATCH_0}")
          math(EXPR failures "${failures} + 1")
        endif()
        foreach(pair "A;${reqOff}" "A;${req_${m}}" "B;${reqOn}" "B;${req_${m}}" "B;${useRe}")
          list(GET pair 0 run)
          list(GET pair 1 re)
          if(NOT flat${run} MATCHES "${re}")
            message(SEND_ERROR "${dump} ${p} ${s} ${m}: run ${run} has no line matching \"${re}\"")
            math(EXPR failures "${failures} + 1")
          endif()
        endforeach()
        file(GLOB pngs RELATIVE "${dirA}" "${dirA}/*.png")
        foreach(need SCENE.png DISPLAY.png)
          if(NOT need IN_LIST pngs)
            message(SEND_ERROR "${dump} ${p} ${s} ${m}: no ${need} written")
            math(EXPR failures "${failures} + 1")
          endif()
        endforeach()
        set(n 0)
        foreach(png IN LISTS pngs)
          if(NOT EXISTS "${dirB}/${png}")
            message(SEND_ERROR "${dump} ${p} ${s} ${m}: ${png} written under ICO_RD_VU_FLAT0=0 only")
            math(EXPR failures "${failures} + 1")
            continue()
          endif()
          execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${dirA}/${png}"
                                  "${dirB}/${png}" RESULT_VARIABLE same)
          if(NOT same EQUAL 0)
            message(SEND_ERROR "${dump} ${p} ${s} ${m}: ${png} differs")
            math(EXPR failures "${failures} + 1")
          endif()
          math(EXPR n "${n} + 1")
        endforeach()
        file(GLOB pngsB RELATIVE "${dirB}" "${dirB}/*.png")
        foreach(png IN LISTS pngsB)
          if(NOT EXISTS "${dirA}/${png}")
            message(SEND_ERROR "${dump} ${p} ${s} ${m}: ${png} written under ICO_RD_VU_FLAT0=1 only")
            math(EXPR failures "${failures} + 1")
          endif()
        endforeach()
        math(EXPR compared "${compared} + ${n}")
        math(EXPR compared_${p} "${compared_${p}} + ${n}")
        message(STATUS "${dump} ${p} ${s} ${m}: ${n} targets compared")
        # the folders of a pair that matched are not kept (thousands of PNGs)
        if(failures EQUAL 0)
          file(REMOVE_RECURSE "${dirA}" "${dirB}")
        endif()
      endforeach()
    endforeach()
  endforeach()
endforeach()
foreach(p IN LISTS profiles)
  if(asked_${p} AND compared_${p} EQUAL 0)
    message(SEND_ERROR "rd_vu_flat0_ab: no target compared under the ${p} profile")
    math(EXPR failures "${failures} + 1")
  endif()
endforeach()
message(STATUS "rd_vu_flat0_ab (${BACKEND}): ${compared} targets compared over ${nentries} dumps "
               "(corpus ${compared_corpus}, mali ${compared_mali}, pixel ${compared_pixel}), "
               "${missing} listed dumps not here")
if(failures GREATER 0)
  message(FATAL_ERROR "rd_vu_flat0_ab: ${failures} failures")
endif()

# rd_replay_tool_keys: every pipeline a replay asks for is in the start-up set.
#   rd_replay_tool --keys walks each dump of ICO_DUMPS with nothing drawn, makes
#   the keys the replay names and compares them with rd__enumerate_reachable's
#   set; it exits 1 on a key the set lacks (a first-use stall on a device) and
#   prints "<dump>: key: in set|MISSING <family>: <words>" a key.
#   - the dumps: ICO_DUMPS names a list (one path a line, '#' comments, relative
#     paths relative to the list) or a folder of .rddump / .zip files, as
#     tools/native_frame_check.py reads it; the test skips without it
#   - each dump at 1x (the Original preset), at --enhanced --resolution 2x and at
#     --enhanced --resolution 2340x1080, on the fake phone limits
#     (ICO_VK_FAKE_LIMITS=mali: the bind group limits of a Mali-G68)
#   - then again as a tile-based GPU's set is made (ICO_RD_DATE_PATH=stencil,
#     ICO_RD_FOG_PATH=local, ICO_RD_BLUR_FOLD=1, the fake limits off: the fake
#     limits drop the local read): the tool's profile line says whether the
#     device took them; a device without local read keeps the desktop set and
#     that half reports "no local read" and passes
#   - the union of the asked keys goes to ${OUT}/keys-<config>.txt, a line a key,
#     sorted
# -DTOOL=<rd_replay_tool> -DOUT=<a folder the test may write>
if(NOT DEFINED ENV{ICO_DUMPS} OR "$ENV{ICO_DUMPS}" STREQUAL "")
  message(STATUS "SKIP: ICO_DUMPS is not set")
  return()
endif()
set(src "$ENV{ICO_DUMPS}")
set(dumps "")
if(IS_DIRECTORY "${src}")
  file(GLOB dumps "${src}/*.rddump" "${src}/*.zip")
elseif(EXISTS "${src}")
  get_filename_component(base "${src}" DIRECTORY)
  file(STRINGS "${src}" lines)
  foreach(l ${lines})
    string(STRIP "${l}" l)
    if(l STREQUAL "" OR l MATCHES "^#")
      continue()
    endif()
    if(NOT IS_ABSOLUTE "${l}")
      set(l "${base}/${l}")
    endif()
    if(EXISTS "${l}")
      list(APPEND dumps "${l}")
    endif()
  endforeach()
endif()
if(NOT dumps)
  message(STATUS "SKIP: no dump in ICO_DUMPS (${src})")
  return()
endif()
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")

set(res_names 1x 2x 2340x1080)
set(res_1x "")
set(res_2x --enhanced --resolution 2x)
set(res_2340x1080 --enhanced --resolution 2340x1080)

# a configuration: its name and the environment it sets (name=value pairs)
set(configs mali tiler)
set(env_mali "ICO_VK_FAKE_LIMITS=mali")
set(env_tiler "ICO_RD_DATE_PATH=stencil;ICO_RD_FOG_PATH=local;ICO_RD_BLUR_FOLD=1")

set(failed 0)
foreach(cfg ${configs})
  foreach(kv ${env_${cfg}})
    string(REGEX MATCH "^([^=]+)=(.*)$" _ "${kv}")
    set(ENV{${CMAKE_MATCH_1}} "${CMAKE_MATCH_2}")
  endforeach()
  foreach(res ${res_names})
    set(union "")
    set(took_local 0)
    foreach(d ${dumps})
      get_filename_component(dn "${d}" NAME)
      execute_process(COMMAND "${TOOL}" "${d}" - --keys ${res_${res}}
                      RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
      if(rc EQUAL 77)
        message(STATUS "SKIP: no device: ${err}")
        return()
      endif()
      if(NOT rc EQUAL 0 AND NOT rc EQUAL 1)
        message(SEND_ERROR "${cfg} ${res} ${dn}: --keys exited ${rc}:\n${out}\n${err}")
        math(EXPR failed "${failed} + 1")
        continue()
      endif()
      if(NOT out MATCHES "keys: [0-9]+ asked in [0-9]+ rounds, [0-9]+ in the set of [0-9]+, ([0-9]+) missing")
        message(SEND_ERROR "${cfg} ${res} ${dn}: no summary line:\n${out}\n${err}")
        math(EXPR failed "${failed} + 1")
        continue()
      endif()
      set(n_missing "${CMAKE_MATCH_1}")
      if(out MATCHES "keys: profile tiler [01], local read 1,")
        set(took_local 1)
      endif()
      string(REPLACE "\n" ";" ls "${out}")
      foreach(l ${ls})
        if(l MATCHES "^.*: key: (.*)$")
          list(APPEND union "${CMAKE_MATCH_1}")
        endif()
      endforeach()
      if(NOT n_missing EQUAL 0 OR NOT rc EQUAL 0)
        string(REGEX MATCHALL "[^\n]*key: MISSING[^\n]*" ms "${out}")
        message(SEND_ERROR "${cfg} ${res} ${dn}: keys the start-up set lacks:\n${ms}")
        math(EXPR failed "${failed} + 1")
      endif()
    endforeach()
    list(REMOVE_DUPLICATES union)
    list(SORT union)
    string(REPLACE ";" "\n" body "${union}")
    file(WRITE "${OUT}/keys-${cfg}-${res}.txt" "${body}\n")
    list(LENGTH union nu)
    list(LENGTH dumps nd)
    message(STATUS "${cfg} ${res}: ${nu} distinct keys asked over ${nd} dumps")
    if(cfg STREQUAL "tiler" AND NOT took_local)
      message(STATUS "tiler ${res}: no local read on this device: the desktop set was compared")
    endif()
  endforeach()
  foreach(kv ${env_${cfg}})
    string(REGEX MATCH "^([^=]+)=" _ "${kv}")
    unset(ENV{${CMAKE_MATCH_1}})
  endforeach()
endforeach()
if(failed)
  message(FATAL_ERROR "${failed} replays asked for keys the start-up set lacks or failed")
endif()

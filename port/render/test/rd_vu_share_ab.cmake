# rd_vu_share_ab: shared vertices for clip-mode-none strips
# (port/render/rd_vu_share.c, rd_vu_share.h; docs/port/PIPELINES.md, "Shared
# vertices for clip mode none"; issue 179): the shared lists (ICO_RD_VU_SHARE=1,
# the shipped behaviour) against the original lists (=0), byte for byte.  The
# frames: every fixture of LIST (port/render/test/fixtures/lists/vu_share.txt: a
# fixture, the profiles it is replayed under, then its QUANTITY OP VALUE words,
# rd_fixture_list_props.cmake), each expanded into ${OUT}/fixtures
# (docs/port/TESTING_FIXTURES.md).  For every frame, rd_replay_tool --pass-dump
# with --stats twice, ICO_RD_VU_SHARE=0 and =1, at each setting of each of its
# profiles, each with the draw merge (the merge build vu_merge_main_vs: the
# shared list raised in the run's list) and without it (ICO_RD_VU_MERGE=0: the
# draw's own list in the mesh's device copy):
#   corpus  the device as it is: the Original preset at 4:3 and 1x, and the
#           Enhanced preset at 16:9 and 2x
#   mali    issue 179's Mali-G52 on lavapipe: the Arm fakes
#           (ICO_VK_FAKE_LIMITS=mali, ICO_VK_FAKE_VENDOR=0x13B5), the record
#           by compute dispatches as on that phone (ICO_RD_VU_RECORD=compute),
#           its settings: 1x, 21:9
#   pixel   the Pixel 10 Pro Fold's (ICO_VK_FAKE_LIMITS=moltenvk, Enhanced at
#           2364x1080, full height, full pixel, presented at 2364x1080)
# With BACKEND other than vulkan (the OpenGL twin) every frame takes the corpus
# settings alone (the fakes are Vulkan's).  Every target's PNG (SCENE and
# DISPLAY among them) must be equal byte for byte; the =0 run must say "stats:
# VU shared vertices off (ICO_RD_VU_SHARE=0): 0 triangles" and the =1 run
# "stats: VU shared vertices on: "; the merged runs "merge on)", the others
# "merge off)".  A frame whose =0 run draws nothing through the record (no
# "stats: VU pre-pass on: [1-9]" line) is skipped at that setting, as is a 4:3
# frame the 16:9 setting cannot show; every profile with a frame here must have
# compared targets.  The path ran: on every =1 run compared, the triangles drawn
# with shared vertices against the fixture's declared vu_shared_triangles; a
# fixture with no pair compared under one of its profiles fails.  No frame
# here, or no device (77): SKIP.
# -DTOOL=<rd_replay_tool> -DOUT=<a folder the test may write> -DLIST=<list>
# -DFIXTURE_TOOL=... -DFIXTURES=... -DFIXTURE_HELPERS=...
# [-DBACKEND=vulkan|opengl (default vulkan)]
cmake_policy(SET CMP0057 NEW) # if(... IN_LIST ...) in a -P script
# an entry's empty name field (a path list's "prof|dump|") kept as an element:
# CMake 4 has no OLD behaviour, the Windows runner's CMake 3 dropped it and
# list(GET ef 2) failed (CI run 43805687280, windows job, D3D11 on WARP)
cmake_policy(SET CMP0007 NEW)
if(NOT BACKEND)
  set(BACKEND vulkan)
endif()
set(profiles corpus mali pixel)
set(entries "")
set(failures 0)
set(missing 0)
set(fixtures FALSE)
if(DEFINED FIXTURE_TOOL AND NOT "${FIXTURE_TOOL}" STREQUAL "")
  set(fixtures TRUE)
  include("${FIXTURE_HELPERS}")
  include("${CMAKE_CURRENT_LIST_DIR}/rd_fixture_list_props.cmake")
  rd_fixture_list("${LIST}" fxNames)
  foreach(name IN LISTS fxNames)
    string(REGEX MATCH "^[^ \t]+" prof "${RDFX_FIELDS_${name}}")
    if(NOT prof MATCHES "^[a-z,]+$")
      message(SEND_ERROR "rd_vu_share_ab: ${LIST}: ${name}: \"${prof}\" is not its profiles")
      math(EXPR failures "${failures} + 1")
      continue()
    endif()
    string(REPLACE "," ";" profList "${prof}")
    foreach(p IN LISTS profList)
      if(NOT p IN_LIST profiles)
        message(SEND_ERROR "rd_vu_share_ab: ${LIST}: ${name}: \"${p}\" is none of ${profiles}")
        math(EXPR failures "${failures} + 1")
      endif()
    endforeach()
    rd_fixture_list_props(${name})
    rd_fixture_expand(${name} "${OUT}/fixtures" dump)
    list(APPEND entries "${prof}|${dump}|${name}")
  endforeach()
elseif(LIST)
  if(NOT EXISTS "${LIST}")
    message(STATUS "rd_vu_share_ab: ${LIST}: no dump list, skipped")
  else()
    get_filename_component(listDir "${LIST}" DIRECTORY)
    file(STRINGS "${LIST}" lines)
    foreach(l IN LISTS lines)
      string(STRIP "${l}" l)
      if(l STREQUAL "" OR l MATCHES "^#")
        continue()
      endif()
      if(NOT l MATCHES "^([a-z,]+)[ \t]+(.+)$")
        message(SEND_ERROR "rd_vu_share_ab: ${LIST}: \"${l}\" is not \"profiles name\"")
        math(EXPR failures "${failures} + 1")
        continue()
      endif()
      set(prof "${CMAKE_MATCH_1}")
      set(path "${CMAKE_MATCH_2}")
      string(REPLACE "," ";" profList "${prof}")
      foreach(p IN LISTS profList)
        if(NOT p IN_LIST profiles)
          message(SEND_ERROR "rd_vu_share_ab: ${LIST}: \"${p}\" is none of ${profiles}")
          math(EXPR failures "${failures} + 1")
        endif()
      endforeach()
      if(NOT IS_ABSOLUTE "${path}")
        set(path "${listDir}/${path}")
      endif()
      if(NOT EXISTS "${path}")
        math(EXPR missing "${missing} + 1")
        message(STATUS "rd_vu_share_ab: ${LIST} names ${path}, which is not here: skipped")
        continue()
      endif()
      list(APPEND entries "${prof}|${path}|")
    endforeach()
  endif()
endif()
list(LENGTH entries nentries)
if(nentries EQUAL 0)
  if(failures GREATER 0)
    message(FATAL_ERROR "rd_vu_share_ab: ${failures} failures, no frame replayed")
  endif()
  message(STATUS "SKIP: no frame is here")
  return()
endif()

set(env_corpus "")
set(env_mali ICO_VK_FAKE_LIMITS=mali ICO_VK_FAKE_VENDOR=0x13B5 ICO_RD_VU_RECORD=compute)
set(env_pixel ICO_VK_FAKE_LIMITS=moltenvk)
set(settings_corpus orig enh169)
set(settings_mali mali)
set(settings_pixel pixel)
set(args_orig --aspect 4:3)
set(args_enh169 --enhanced --aspect 16:9 --resolution 2x)
set(args_mali --aspect 21:9)
set(args_pixel --enhanced --resolution 2364x1080 --full-height --full-pixel --present 2364x1080)
set(merges merge nomerge)
set(env_merge "")
set(env_nomerge ICO_RD_VU_MERGE=0)
set(req_merge "merge on\\)")
set(req_nomerge "merge off\\)")
set(reqOff "stats: VU shared vertices off \\(ICO_RD_VU_SHARE=0\\): 0 triangles")
set(reqOn "stats: VU shared vertices on: ")
set(useRe "stats: VU pre-pass on: [1-9]")
foreach(p IN LISTS profiles)
  set(asked_${p} 0)
  set(compared_${p} 0)
endforeach()
set(compared 0)
set(index 0)
foreach(e IN LISTS entries)
  string(REPLACE "|" ";" ef "${e}")
  list(GET ef 0 prof)
  list(GET ef 1 dump)
  list(GET ef 2 name)
  string(REPLACE "," ";" profList "${prof}")
  if(NOT BACKEND STREQUAL "vulkan")
    set(profList corpus)
  endif()
  list(REMOVE_DUPLICATES profList)
  foreach(p IN LISTS profList)
    set(asked_${p} 1)
    set(fxPairs 0)
    foreach(s IN LISTS settings_${p})
      foreach(m IN LISTS merges)
        math(EXPR index "${index} + 1")
        set(dirA "${OUT}/${index}-${p}-${s}-${m}-orig")
        set(dirB "${OUT}/${index}-${p}-${s}-${m}-shared")
        file(REMOVE_RECURSE "${dirA}" "${dirB}")
        file(MAKE_DIRECTORY "${dirA}" "${dirB}")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${env_${p}} ${env_${m}}
                                ICO_RD_VU_SHARE=0 "${TOOL}" "${dump}" /dev/null
                                --pass-dump "${dirA}" --stats ${args_${s}}
                        RESULT_VARIABLE rcA OUTPUT_VARIABLE outA ERROR_VARIABLE errA)
        if(rcA EQUAL 77)
          message(STATUS "SKIP: no device: ${errA}")
          return()
        endif()
        if(NOT rcA EQUAL 0 AND "${errA}" MATCHES "cannot show")
          message(STATUS "${dump} ${p} ${s} ${m}: skipped (${errA})")
          continue()
        endif()
        string(REPLACE ";" "," flatA "${outA}\n${errA}")
        if(rcA EQUAL 0 AND NOT flatA MATCHES "${useRe}")
          message(STATUS "${dump} ${p} ${s} ${m}: skipped (nothing drawn through the record)")
          continue()
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${env_${p}} ${env_${m}}
                                ICO_RD_VU_SHARE=1 "${TOOL}" "${dump}" /dev/null
                                --pass-dump "${dirB}" --stats ${args_${s}}
                        RESULT_VARIABLE rcB OUTPUT_VARIABLE outB ERROR_VARIABLE errB)
        if(NOT rcA EQUAL 0 OR NOT rcB EQUAL 0)
          message(SEND_ERROR "${dump} ${p} ${s} ${m}: exit ${rcA} (=0) and ${rcB} (=1):\n${errA}\n${errB}")
          math(EXPR failures "${failures} + 1")
          continue()
        endif()
        string(REPLACE ";" "," flatB "${outB}\n${errB}")
        # the Direct3D 11 debug layer's findings (tools/ci_d3d11_warp.sh runs
        # this script on WARP with ICO_D3D11_DEBUG=1)
        if("${errA}${errB}" MATCHES "rhi_d3d11 debug (error|corruption)[^\n]*")
          message(SEND_ERROR "${dump} ${p} ${s} ${m}: ${CMAKE_MATCH_0}")
          math(EXPR failures "${failures} + 1")
        endif()
        foreach(pair "A;${reqOff}" "A;${req_${m}}" "B;${reqOn}" "B;${req_${m}}" "B;${useRe}")
          list(GET pair 0 run)
          list(GET pair 1 re)
          if(NOT flat${run} MATCHES "${re}")
            message(SEND_ERROR "${dump} ${p} ${s} ${m}: run ${run} has no line matching \"${re}\"")
            math(EXPR failures "${failures} + 1")
          endif()
        endforeach()
        # the path ran: the triangles drawn with shared vertices
        if(NOT name STREQUAL "")
          rd_fixture_require(${name} "${outB}\n${errB}" vu_shared_triangles)
        endif()
        file(GLOB pngs RELATIVE "${dirA}" "${dirA}/*.png")
        foreach(need SCENE.png DISPLAY.png)
          if(NOT need IN_LIST pngs)
            message(SEND_ERROR "${dump} ${p} ${s} ${m}: no ${need} written")
            math(EXPR failures "${failures} + 1")
          endif()
        endforeach()
        set(n 0)
        foreach(png IN LISTS pngs)
          if(NOT EXISTS "${dirB}/${png}")
            message(SEND_ERROR "${dump} ${p} ${s} ${m}: ${png} written under ICO_RD_VU_SHARE=0 only")
            math(EXPR failures "${failures} + 1")
            continue()
          endif()
          execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${dirA}/${png}"
                                  "${dirB}/${png}" RESULT_VARIABLE same)
          if(NOT same EQUAL 0)
            message(SEND_ERROR "${dump} ${p} ${s} ${m}: ${png} differs")
            math(EXPR failures "${failures} + 1")
          endif()
          math(EXPR n "${n} + 1")
        endforeach()
        file(GLOB pngsB RELATIVE "${dirB}" "${dirB}/*.png")
        foreach(png IN LISTS pngsB)
          if(NOT EXISTS "${dirA}/${png}")
            message(SEND_ERROR "${dump} ${p} ${s} ${m}: ${png} written under ICO_RD_VU_SHARE=1 only")
            math(EXPR failures "${failures} + 1")
          endif()
        endforeach()
        math(EXPR compared "${compared} + ${n}")
        math(EXPR compared_${p} "${compared_${p}} + ${n}")
        if(n GREATER 0)
          math(EXPR fxPairs "${fxPairs} + 1")
        endif()
        message(STATUS "${dump} ${p} ${s} ${m}: ${n} targets compared")
        # the folders of a pair that matched are not kept (thousands of PNGs)
        if(failures EQUAL 0)
          file(REMOVE_RECURSE "${dirA}" "${dirB}")
        endif()
      endforeach()
    endforeach()
    if(NOT name STREQUAL "" AND fxPairs EQUAL 0)
      message(SEND_ERROR "${name}: no pair compared under the ${p} profile (no setting could show it, "
                         "nothing drawn through the record, or its runs failed)")
      math(EXPR failures "${failures} + 1")
    endif()
  endforeach()
endforeach()
foreach(p IN LISTS profiles)
  if(asked_${p} AND compared_${p} EQUAL 0)
    message(SEND_ERROR "rd_vu_share_ab: no target compared under the ${p} profile")
    math(EXPR failures "${failures} + 1")
  endif()
endforeach()
if(fixtures)
  math(EXPR failures "${failures} + ${RDFX_FAILURES}")
endif()
message(STATUS "rd_vu_share_ab (${BACKEND}): ${compared} targets compared over ${nentries} frames "
               "(corpus ${compared_corpus}, mali ${compared_mali}, pixel ${compared_pixel}), "
               "${missing} listed dumps not here")
if(failures GREATER 0)
  message(FATAL_ERROR "rd_vu_share_ab: ${failures} failures")
endif()

# rd_thread_ab: the replays on the render thread against the replays where
# they are made, byte for byte (port/render/rd_thread.h; docs/port/RENDER.md,
# "The render thread").  For every dump the lists name (tools/vustage_dumps.txt
# and tools/vufuse_dumps.txt, read as rd_store_plan_ab.cmake reads them),
# rd_replay_tool's --pass-dump with --render-thread off, sync (every job
# waited for) and on (the pictures handed over), at two settings:
#   orig    Original at the dump's aspect, presented at 640x480;
#   enh2x   Enhanced 2x 4:3, presented at 1280x960;
# and for every F12 zip (the frame and the tick before it) the blended
# present between them, --interp 0.5 <zip>, presented, at Enhanced 2x.
# Every target's PNG of sync and on must equal off's byte for byte, and the
# sync and on runs must say "render thread: sync" / "render thread: on" (the
# thread ran); the blended present's on run must say "submit thread: ended
# (N" with N above 0 (its submit and present ran on the submit thread,
# port/render/rd_submit_thread.h).  A missing list or dump is named and skipped; no dump read, or
# no device: SKIP (77).
# -DTOOL=<rd_replay_tool> -DLIST=<dump list> -DEXTRA=<a second dump list>
# -DOUT=<a folder the test may write>
set(dumps "")
foreach(list IN ITEMS "${LIST}" "${EXTRA}")
  if(list STREQUAL "" OR NOT EXISTS "${list}")
    message(STATUS "${list}: no dump list, skipped")
    continue()
  endif()
  get_filename_component(listDir "${list}" DIRECTORY)
  file(STRINGS "${list}" lines)
  foreach(l IN LISTS lines)
    string(STRIP "${l}" l)
    if(l STREQUAL "" OR l MATCHES "^#")
      continue()
    endif()
    if(NOT IS_ABSOLUTE "${l}")
      set(l "${listDir}/${l}")
    endif()
    if(l MATCHES "[*]")
      file(GLOB matched "${l}")
      list(SORT matched)
      if(matched)
        list(APPEND dumps ${matched})
      else()
        message(STATUS "${l}: no dump matches, skipped")
      endif()
    elseif(EXISTS "${l}")
      list(APPEND dumps "${l}")
    else()
      message(STATUS "${l}: no such dump, skipped")
    endif()
  endforeach()
endforeach()
list(REMOVE_DUPLICATES dumps)
list(LENGTH dumps ndumps)
if(ndumps EQUAL 0)
  message(STATUS "SKIP: no dump of ${LIST} or ${EXTRA} is here")
  return()
endif()

set(settings "orig" "enh2x")
set(args_orig --present 640x480)
set(args_enh2x --enhanced --resolution 2x --aspect 4:3 --present 1280x960)
set(runs "off" "sync" "on")
set(compared 0)
set(interps 0)
set(failures 0)
set(index 0)
foreach(dump IN LISTS dumps)
  math(EXPR index "${index} + 1")
  set(cases ${settings})
  if(dump MATCHES "\\.zip$")
    list(APPEND cases "interp")
  endif()
  foreach(s IN LISTS cases)
    set(ok TRUE)
    foreach(run IN LISTS runs)
      set(dir_${run} "${OUT}/${index}-${s}-${run}")
      file(REMOVE_RECURSE "${dir_${run}}")
      file(MAKE_DIRECTORY "${dir_${run}}")
      if(s STREQUAL "interp")
        set(cmd "${TOOL}" "${dump}" "${dir_${run}}/PRESENT.png" --interp 0.5 "${dump}"
                ${args_enh2x})
      else()
        set(cmd "${TOOL}" "${dump}" - --pass-dump "${dir_${run}}" ${args_${s}})
      endif()
      execute_process(COMMAND ${cmd} --render-thread ${run}
                      RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
      if(rc EQUAL 77)
        message(STATUS "SKIP: no device: ${err}")
        return()
      endif()
      if(NOT rc EQUAL 0)
        message(SEND_ERROR "${dump} ${s} ${run}: exit ${rc}:\n${err}")
        set(ok FALSE)
        break()
      endif()
      if(NOT run STREQUAL "off" AND NOT "${out}${err}" MATCHES "render thread: ${run} ")
        message(SEND_ERROR "${dump} ${s} ${run}: the render thread did not say it ran:\n${err}")
        set(ok FALSE)
        break()
      endif()
      # the blended present handed over: its submit and present on the
      # submit thread (rd_submit_thread.h), at least one picture there
      if(run STREQUAL "on" AND s STREQUAL "interp" AND
         NOT "${out}${err}" MATCHES "submit thread: ended \\([1-9]")
        message(SEND_ERROR "${dump} ${s} on: no picture was submitted on the submit thread:\n${err}")
        set(ok FALSE)
        break()
      endif()
    endforeach()
    if(NOT ok)
      math(EXPR failures "${failures} + 1")
      continue()
    endif()
    file(GLOB pngs RELATIVE "${dir_off}" "${dir_off}/*.png")
    list(LENGTH pngs npng)
    if(npng EQUAL 0)
      message(SEND_ERROR "${dump} ${s}: no target written")
      math(EXPR failures "${failures} + 1")
    endif()
    foreach(png IN LISTS pngs)
      foreach(run sync on)
        if(NOT EXISTS "${dir_${run}}/${png}")
          message(SEND_ERROR "${dump} ${s}: ${png} written with the render thread off only (${run})")
          math(EXPR failures "${failures} + 1")
          continue()
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${dir_off}/${png}"
                                "${dir_${run}}/${png}" RESULT_VARIABLE same)
        math(EXPR compared "${compared} + 1")
        if(NOT same EQUAL 0)
          message(SEND_ERROR "${dump} ${s}: ${png} differs between the render thread off and "
                             "${run}")
          math(EXPR failures "${failures} + 1")
        endif()
      endforeach()
    endforeach()
    if(s STREQUAL "interp")
      math(EXPR interps "${interps} + 1")
    endif()
    message(STATUS "${dump} ${s}: ${npng} pictures, off = sync = on")
  endforeach()
endforeach()
if(compared EQUAL 0 AND failures EQUAL 0)
  message(STATUS "SKIP: no dump of ${LIST} or ${EXTRA} could be compared")
  return()
endif()
message(STATUS "rd_thread_ab: ${compared} pictures compared over ${ndumps} dumps (${interps} "
               "blended presents)")
if(failures GREATER 0)
  message(FATAL_ERROR "rd_thread_ab: ${failures} failures")
endif()

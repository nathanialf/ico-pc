/*
 * port/input/keys.def
 *
 * The keyboard keys a binding can name, as KEY(ID, "config name", SDL
 * scancode): bindings.c uses the first two (SDL-free), input_sdl.c the
 * third. Physical positions (scancodes), so WASD stays WASD on any layout.
 * Names are case-insensitive in config.toml. Escape, Android's Back button
 * and Alt+Enter (fullscreen) are reserved and not listed: Escape and Back
 * press Start in play and Triangle elsewhere (window_host.c escape_event,
 * mouse_look.h ico_escape_target).
 */
KEY(A, "A", SDL_SCANCODE_A)
KEY(B, "B", SDL_SCANCODE_B)
KEY(C, "C", SDL_SCANCODE_C)
KEY(D, "D", SDL_SCANCODE_D)
KEY(E, "E", SDL_SCANCODE_E)
KEY(F, "F", SDL_SCANCODE_F)
KEY(G, "G", SDL_SCANCODE_G)
KEY(H, "H", SDL_SCANCODE_H)
KEY(I, "I", SDL_SCANCODE_I)
KEY(J, "J", SDL_SCANCODE_J)
KEY(K, "K", SDL_SCANCODE_K)
KEY(L, "L", SDL_SCANCODE_L)
KEY(M, "M", SDL_SCANCODE_M)
KEY(N, "N", SDL_SCANCODE_N)
KEY(O, "O", SDL_SCANCODE_O)
KEY(P, "P", SDL_SCANCODE_P)
KEY(Q, "Q", SDL_SCANCODE_Q)
KEY(R, "R", SDL_SCANCODE_R)
KEY(S, "S", SDL_SCANCODE_S)
KEY(T, "T", SDL_SCANCODE_T)
KEY(U, "U", SDL_SCANCODE_U)
KEY(V, "V", SDL_SCANCODE_V)
KEY(W, "W", SDL_SCANCODE_W)
KEY(X, "X", SDL_SCANCODE_X)
KEY(Y, "Y", SDL_SCANCODE_Y)
KEY(Z, "Z", SDL_SCANCODE_Z)
KEY(N1, "1", SDL_SCANCODE_1)
KEY(N2, "2", SDL_SCANCODE_2)
KEY(N3, "3", SDL_SCANCODE_3)
KEY(N4, "4", SDL_SCANCODE_4)
KEY(N5, "5", SDL_SCANCODE_5)
KEY(N6, "6", SDL_SCANCODE_6)
KEY(N7, "7", SDL_SCANCODE_7)
KEY(N8, "8", SDL_SCANCODE_8)
KEY(N9, "9", SDL_SCANCODE_9)
KEY(N0, "0", SDL_SCANCODE_0)
KEY(SPACE, "Space", SDL_SCANCODE_SPACE)
KEY(RETURN, "Enter", SDL_SCANCODE_RETURN)
KEY(TAB, "Tab", SDL_SCANCODE_TAB)
KEY(BACKSPACE, "Backspace", SDL_SCANCODE_BACKSPACE)
KEY(GRAVE, "Backquote", SDL_SCANCODE_GRAVE)
KEY(MINUS, "Minus", SDL_SCANCODE_MINUS)
KEY(EQUALS, "Equals", SDL_SCANCODE_EQUALS)
KEY(LBRACKET, "LeftBracket", SDL_SCANCODE_LEFTBRACKET)
KEY(RBRACKET, "RightBracket", SDL_SCANCODE_RIGHTBRACKET)
KEY(BACKSLASH, "Backslash", SDL_SCANCODE_BACKSLASH)
KEY(SEMICOLON, "Semicolon", SDL_SCANCODE_SEMICOLON)
KEY(APOSTROPHE, "Quote", SDL_SCANCODE_APOSTROPHE)
KEY(COMMA, "Comma", SDL_SCANCODE_COMMA)
KEY(PERIOD, "Period", SDL_SCANCODE_PERIOD)
KEY(SLASH, "Slash", SDL_SCANCODE_SLASH)
KEY(LSHIFT, "LeftShift", SDL_SCANCODE_LSHIFT)
KEY(RSHIFT, "RightShift", SDL_SCANCODE_RSHIFT)
KEY(LCTRL, "LeftCtrl", SDL_SCANCODE_LCTRL)
KEY(RCTRL, "RightCtrl", SDL_SCANCODE_RCTRL)
KEY(LALT, "LeftAlt", SDL_SCANCODE_LALT)
KEY(RALT, "RightAlt", SDL_SCANCODE_RALT)
KEY(UP, "Up", SDL_SCANCODE_UP)
KEY(DOWN, "Down", SDL_SCANCODE_DOWN)
KEY(LEFT, "Left", SDL_SCANCODE_LEFT)
KEY(RIGHT, "Right", SDL_SCANCODE_RIGHT)

; ico2/vusrc/normal_c.dsm /* derived name */: NormalCMicroProgram, ico2000.a(normal_c.o).
; The listing has no source rows for the VU objects; the path is the one
; whose hash the base's overlay section .DVP.overlay..0x0.<hash>.11.0
; carries (tc-dvp.c vuoverlay_section_name), assembled from ico2/.
;
; The program text is vusrc/normal_c.vsm, which the period cpp reads from standard
; input into vusrc/normal_c.i, the file included here (the vucpp and vu rules).
	.global NormalCMicroProgram
NormalCMicroProgram:
	DMAret *
	MPG 0, *
	.include "vusrc/normal_c.i"
	.EndMPG
	.EndDmaData
	DMAend
;
; One of ICO's five VU1 microprograms (PAL 0x0028B380, JPN 0x00289290, KOR
; 0x00289310, Asian 0x002892D0, USA 0x00270D90, Aug-6 prototype 0x0026D120, 5856 bytes; Jun-26 demo 0x002593B0, 5872 bytes), sent to VU1 by mc_TransMicroCode (MicroCode.o): a
; DMAret tag whose VIF half carries MPG 0, the program, then a DMAend tag.
; dvp-as writes the tags, a new MPG every 256 instructions and the .DVP
; overlay tables. Each overlay is named with the hash of the file and the line
; dvp-as is reading where it starts: this file at the MPG on line 11, then the
; name cpp writes for the text it is in, "" for standard input, vusrc/<name>.h
; in an include.
;
; Re-derived from published VU0/VU1 documentation; .vutext is identical
; in the Aug-6-2001 prototype and the USA, PAL, Japanese, Korean and Asian retail.
; The Jun-26-2001 demo's program is its own instruction stream (the loops are
; scheduled otherwise), held in normal_c.vsm as the demo's blocks, which cpp
; reads with the target and LN defined. dvp-as names a continuation overlay
; after the .vsm line of its first instruction, taken from cpp's line markers,
; and the base ELF carries the name: the second overlay starts at line 244 of
; both texts but at another instruction of each, inside a block's arm, so each
; has a `#line 244 ""` before it (mesh.dsm on the form; the third overlay
; starts in scissorcommcut.h, at the include's own line).
; The labels are the DVP assembler's own, from the PAL listing's .vutext table
; (spelled _$NAME there, the copy dvp-as makes), each at the listing's address.

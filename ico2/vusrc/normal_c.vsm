; ico2/vusrc/normal_c.vsm /* derived name */: the program text of vusrc/normal_c.dsm.
#define VERTEX_QW 3 /* derived name */
; Program-3 entry-stub dispatch (continuous from here through 0x18E8).
	nop                              b SET_GSREGISTER                       ; 0x17C0 - entry -> SET_GSREGISTER
	nop                              nop                                    ; delay slot
	nop                              b SET_UVOFFSET                         ; 0x17D0 - entry -> SET_UVOFFSET
	nop                              nop                                    ; delay slot
	nop                              nop                                    ; 0x17E0 - reserved slot
	nop                              nop                                    ; 0x17E8 - reserved slot
	nop                              nop                                    ; 0x17F0 - reserved slot
	nop                              nop                                    ; 0x17F8 - reserved slot
	nop                              b SET_FONT_OFFSET                      ; 0x1800 - entry -> SET_FONT_OFFSET
	nop                              nop                                    ; delay slot
	nop                              b START_DEBUG_FONT                     ; 0x1810 - entry -> START_DEBUG_FONT
	nop                              nop                                    ; delay slot
	nop                              b SPACE_DEBUG_FONT                     ; 0x1820 - entry -> SPACE_DEBUG_FONT
	nop                              nop                                    ; delay slot
	nop                              nop                                    ; 0x1830 - reserved slot
	nop                              nop                                    ; 0x1838 - reserved slot
	nop                              b SET_NORMAL_MATRIX                    ; 0x1840 - entry -> SET_NORMAL_MATRIX
	nop                              nop                                    ; delay slot
	nop                              b SET_NORMAL_LIGHT                     ; 0x1850 - entry -> SET_NORMAL_LIGHT
	nop                              nop                                    ; delay slot
	nop                              nop                                    ; 0x1860 - reserved slot
	nop                              nop                                    ; 0x1868 - reserved slot
	nop                              nop                                    ; 0x1870 - reserved slot
	nop                              nop                                    ; 0x1878 - reserved slot
	nop                              nop                                    ; 0x1880 - reserved slot
	nop                              nop                                    ; 0x1888 - reserved slot
	nop                              nop                                    ; 0x1890 - reserved slot
	nop                              nop                                    ; 0x1898 - reserved slot
	nop                              nop                                    ; 0x18A0 - reserved slot
	nop                              nop                                    ; 0x18A8 - reserved slot
	nop                              nop                                    ; 0x18B0 - reserved slot
	nop                              nop                                    ; 0x18B8 - reserved slot
	nop                              b BEGIN_NORMAL_C                       ; 0x18C0 - entry -> BEGIN_NORMAL_C
	nop                              nop                                    ; delay slot
	nop                              b BEGIN_NORMAL_C_NOCLIP                ; 0x18D0 - entry -> BEGIN_NORMAL_C_NOCLIP
	nop                              nop                                    ; delay slot
	nop                              b BEGIN_SCISSOR_C                             ; 0x18E0 - entry -> sub_2BB0  (far target)
	nop                              nop                                    ; delay slot

#include "vu1_common.h"

; -----------------------------------------------------------------------
; SET_NORMAL_MATRIX - bulk 13-quad copy from VIF input to mem[16..27], plus a
; final `lq mem[3]; sq mem[37]` constant-copy.
;
; The first four quads land in vf01..vf04 (then stored to mem[16..19]);
; the next nine quads all stream through vf31 (each lqi -> sq pair),
; landing in mem[20..27].  At the tail, a fixed `lq vf31, 3(vi00)`
; reads mem[3] and writes it to mem[37].
; -----------------------------------------------------------------------
SET_NORMAL_MATRIX:
	nop                              xtop vi01
	nop                              lqi.xyzw vf01, (vi01++)
	nop                              sq.xyzw vf01, 16(vi00)
	nop                              lqi.xyzw vf02, (vi01++)
	nop                              sq.xyzw vf02, 17(vi00)
	nop                              lqi.xyzw vf03, (vi01++)
	nop                              sq.xyzw vf03, 18(vi00)
	nop                              lqi.xyzw vf04, (vi01++)
	nop                              sq.xyzw vf04, 19(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 20(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 21(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 22(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 23(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 24(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 25(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 26(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 27(vi00)
	nop                              lq.xyzw vf31, 3(vi00)                  ; vf31 = mem[3]
	nop                              sq.xyzw vf31, 37(vi00)                 ; mem[37] = vf31
	nop[e]                           nop                                    ; upper: E-bit pad (END)
	nop                              nop                                    ; E-bit delay slot

; -----------------------------------------------------------------------
; SET_NORMAL_LIGHT - bulk 8-quad copy from VIF input via vf31 to mem[28..35].
; -----------------------------------------------------------------------
SET_NORMAL_LIGHT:
	nop                              xtop vi01
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 28(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 29(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 30(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 31(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 32(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 33(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 34(vi00)
	nop                              lqi.xyzw vf31, (vi01++)
	nop                              sq.xyzw vf31, 35(vi00)
	nop[e]                           nop                                    ; upper: E-bit pad (END)
	nop                              nop                                    ; E-bit delay slot

; BEGIN_NORMAL_C - I-register setup (the two `loi` bundles of SET_MESH_MATRIX in
; mesh) for `addi.w/.xy vf14, vf00`; falls through into START_NORMAL_C.
BEGIN_NORMAL_C:
	nop                              loi 0x4b7ffffe                         ; pad[I] + I = 0x4B7FFFFE
	addi.w vf14, vf00, i             move.xyzw vf13, vf00                   ; vf14.w = I; vf13 = 0
	nop                              loi 0x457ff000                         ; pad[I] + I = 0x457FF000 (= 4094.0f)
	addi.xy vf14, vf00, i            nop                                    ; vf14.xy = I
	nop                              lq.xyzw vf23, 2(vi00)                  ; vf23 = mem[2]
	nop[e]                           nop                                    ; upper: E-bit pad (END)
	nop                              nop                                    ; E-bit delay slot

; -----------------------------------------------------------------------
; START_NORMAL_C - program-3 skinned vertex transform (variant 7).
;
; Restructured variant of START_MESH_LIGHT (mesh) / START_MESH_LIGHT_SPEC (mesh):
;   * Output base is +192 (not +252).
;   * `move.z vf23, vf00` patches vf23.z = 0 mid-setup (mem[2].z mask).
;   * `add.xyz vf21, vf17, vf23` accumulator uses .xyz lanes (not the
;     usual .xy) plus a sub.w guard `sub.w vf00, vf17, vf00`.
;   * `mulw.xyzw vf15, vf24, vf00` / `mulw.xyzw vf28, vf29, vf00` in
;     the loop body (w-broadcast scaled by vf00.w=1).
;   * Two `ibne vi04, vi00, LOOP_NORMAL_C` exit-paths (post-front-face and
;     post-back-face) each kicked by `xgkick vi01` and `b BEGIN_NORMAL_C`
;     back into BEGIN_NORMAL_C pre-END E-bit.
;   * Uses `ibeq vi15, vi00, CONT_NORMAL_C` to skip a reset of vi05 to 3.
; -----------------------------------------------------------------------
START_NORMAL_C:
	nop                              xtop vi13
	nop                              iaddiu vi14, vi00, 32767
	nop                              iaddiu vi02, vi13, 1
	nop                              ilwr.x vi04, (vi13)
	nop                              lq.xyzw vf29, 0(vi13)
	nop                              iand vi04, vi14, vi04
	nop                              iaddiu vi01, vi13, 192                 ; output base = vi13 + 192
	nop                              sq.xyzw vf29, 0(vi01)
	nop                              iaddi vi14, vi14, 1
	nop                              iaddiu vi03, vi01, 1
	nop                              mfir.w vf19, vi00
	nop                              mfir.w vf20, vi14
	nop                              lq.xyzw vf15, 0(vi02)
	sub.w       vf21, vf21, vf21     lq.xyzw vf17, 1(vi02)
	nop                              lq.xyzw vf18, 2(vi02)
	nop                              move.z vf23, vf00                      ; vf23.z = 0 (lane mask)
	mulax.xyzw acc, vf01, vf15x      nop
	madday.xyzw acc, vf02, vf15y     nop
	maddaz.xyzw acc, vf03, vf15z     nop
	maddw.xyzw vf28, vf04, vf00w     nop
	sub.w       vf00, vf17, vf00     lq.xyzw vf15, 3(vi02)
	add.xyz     vf21, vf17, vf23     iaddiu vi07, vi00, 208                 ; vi07 = 0xD0 clip mask
	nop                              nop
	nop                              div q, vf00w, vf28w
	nop                              fsand vi15, 0x2
	nop                              nop
	mulax.xyzw acc, vf01, vf15x      nop
	madday.xyzw acc, vf02, vf15y     nop

LOOP_NORMAL_C:
	maddaz.xyzw acc, vf03, vf15z     lq.xyzw vf17, 4(vi02)
	maddw.xyzw vf29, vf04, vf00w     ibeq vi15, vi00, CONT_NORMAL_C
	nop                              iaddi vi04, vi04, -1                   ; (delay slot)
	nop                              iaddiu vi05, vi00, 3
CONT_NORMAL_C:
	mulq.xyz vf28, vf28, q           iaddi vi05, vi05, -1
	mulq.xyz vf21, vf21, q           iaddiu vi02, vi02, 3
	ftoi0.xyzw  vf22, vf18           lq.xyzw vf24, 3(vi02)
	sub.w       vf00, vf17, vf00     div q, vf00w, vf29w
	sub.xyw     vf00, vf13, vf28     lq.xyzw vf18, 2(vi02)
	sub.xyw     vf00, vf28, vf14     sq.xyzw vf21, 0(vi03)
	ftoi4.xyz   vf19, vf28           sq.xyzw vf22, 1(vi03)
	ftoi4.xyz   vf20, vf28           fsand vi15, 0x2
	mulw.xyzw vf15, vf24, vf00w      fmand vi14, vi07
	mulw.xyzw vf28, vf29, vf00w      fmand vi14, vi14
	add.xyz     vf21, vf17, vf23     ibne vi14, vi07, CLIP_NORMAL_C
	nop                              iaddiu vi03, vi03, 3
	nop                              ibgtz vi05, CLIP_NORMAL_C_SET
	nop                              nop                                    ; (delay slot)
	mulax.xyzw acc, vf01, vf15x      ibne vi04, vi00, LOOP_NORMAL_C
	madday.xyzw acc, vf02, vf15y     sq.xyzw vf19, -1(vi03)
	nop                              xgkick vi01
	nop                              nop
	nop                              b BEGIN_NORMAL_C                       ; -> BEGIN_NORMAL_C E-bit
	nop                              nop                                    ; (branch delay slot)
CLIP_NORMAL_C:
	nop                              iaddiu vi05, vi00, 3
CLIP_NORMAL_C_SET:
	mulax.xyzw acc, vf01, vf15x      ibne vi04, vi00, LOOP_NORMAL_C
	madday.xyzw acc, vf02, vf15y     sq.xyzw vf20, -1(vi03)
	nop                              xgkick vi01
	nop                              nop
	nop                              b BEGIN_NORMAL_C                       ; -> BEGIN_NORMAL_C E-bit
	nop                              nop                                    ; (branch delay slot)

; BEGIN_NORMAL_C_NOCLIP - second I-register setup, as BEGIN_NORMAL_C.
BEGIN_NORMAL_C_NOCLIP:
	nop                              loi 0x4b7ffffe                         ; pad[I] + I = 0x4B7FFFFE
	addi.w vf14, vf00, i             move.xyzw vf13, vf00
	nop                              loi 0x457ff000                         ; pad[I] + I = 0x457FF000
	addi.xy vf14, vf00, i            nop
	nop                              lq.xyzw vf23, 2(vi00)
	nop[e]                           nop                                    ; upper: E-bit pad (END)
	nop                              nop                                    ; E-bit delay slot
; --- BEGIN_NORMAL_C_NOCLIP transform body: the loop tail branches back into
; the I-setup tail above, which ends on the E-bit. ---
START_NORMAL_C_NOCLIP:
	nop                              xtop vi13
	nop                              iaddiu vi14, vi00, 32767
	nop                              iaddiu vi02, vi13, 1
	nop                              ilwr.x vi04, (vi13)
	nop                              lq.xyzw vf29, 0(vi13)
	nop                              iand vi04, vi14, vi04
	nop                              iaddiu vi01, vi13, 192
	nop                              sq.xyzw vf29, 0(vi01)
	nop                              iaddi vi14, vi14, 1
	nop                              iaddiu vi03, vi01, 1
	nop                              mfir.w vf19, vi00
	nop                              mfir.w vf20, vi14
	nop                              lq.xyzw vf15, 0(vi02)
	sub.w       vf21, vf21, vf21     lq.xyzw vf17, 1(vi02)
	nop                              lq.xyzw vf18, 2(vi02)
	nop                              move.z vf23, vf00
	mulax.xyzw acc, vf01, vf15x      nop
	madday.xyzw acc, vf02, vf15y     nop
	maddaz.xyzw acc, vf03, vf15z     nop
	maddw.xyzw vf28, vf04, vf00w     nop
	sub.w       vf00, vf17, vf00     lq.xyzw vf15, 3(vi02)
	nop                              iaddiu vi07, vi00, 208
	nop                              nop
	nop                              div q, vf00w, vf28w
	add.xyz     vf21, vf17, vf23     fsand vi15, 0x2
	nop                              nop
	mulax.xyzw acc, vf01, vf15x      nop
LOOP_NORMAL_C_NOCLIP:
	madday.xyzw acc, vf02, vf15y     lq.xyzw vf17, 4(vi02)

	maddaz.xyzw acc, vf03, vf15z     ibeq vi15, vi00, CONT_NORMAL_C_NOCLIP
#line 244 ""
	maddw.xyzw vf29, vf04, vf00w     iaddiu vi02, vi02, 3
	nop                              iaddiu vi05, vi00, 3
CONT_NORMAL_C_NOCLIP:
	mulq.xyz vf28, vf28, q           iaddi vi05, vi05, -1
	mulq.xyz vf21, vf21, q           lq.xyzw vf24, 3(vi02)
	ftoi0.xyzw  vf22, vf18           iaddi vi04, vi04, -1
	ftoi4.xyz   vf19, vf28           div q, vf00w, vf29w
	sub.w       vf00, vf17, vf00     lq.xyzw vf18, 2(vi02)
	ftoi4.xyz   vf20, vf28           sqi.xyzw vf21, (vi03++)
	mulw.xyzw vf15, vf24, vf00w      sqi.xyzw vf22, (vi03++)
	mulw.xyzw vf28, vf29, vf00w      ibgtz vi05, CLIP_NORMAL_C_NOCLIP_SET
	nop                              fsand vi15, 0x2
NOCLIP_NORMAL_C_NOCLIP_SET:
	add.xyz     vf21, vf17, vf23     ibne vi04, vi00, LOOP_NORMAL_C_NOCLIP
	mulax.xyzw acc, vf01, vf15x      sqi.xyzw vf19, (vi03++)
	nop                              xgkick vi01
	nop                              nop
	nop                              b BEGIN_NORMAL_C_NOCLIP                               ; -> BEGIN_NORMAL_C_NOCLIP E-bit
	nop                              nop                                    ; (branch delay slot)
CLIP_NORMAL_C_NOCLIP_SET:
	add.xyz     vf21, vf17, vf23     ibne vi04, vi00, LOOP_NORMAL_C_NOCLIP
	mulax.xyzw acc, vf01, vf15x      sqi.xyzw vf20, (vi03++)
	nop                              xgkick vi01
	nop                              nop
	nop                              b BEGIN_NORMAL_C_NOCLIP                               ; -> BEGIN_NORMAL_C_NOCLIP E-bit
	nop                              nop                                    ; (branch delay slot)

#include "scissorcommcut.h"

; -----------------------------------------------------------------------
; sub_2BC0 - vertex-buffer init / clear.  Sets up vf17/vf31 to known
; values, loads working matrix from mem[20..23], and initializes
; vi14 = 256 (heap base).  Terminates via E-bit.
; -----------------------------------------------------------------------
BEGIN_SCISSOR_C:
	sub.xyzw vf31, vf00, vf00        lq.xyzw vf17, 2(vi00)                  ; vf31 = 0; vf17 = mem[2]
	nop                              lq.xyzw vf13, 20(vi00)
	nop                              lq.xyzw vf14, 21(vi00)
	nop                              lq.xyzw vf15, 22(vi00)
	nop                              lq.xyzw vf16, 23(vi00)
	mulw.w vf17, vf00, vf00w         iaddiu vi14, vi00, 256
	nop                              move.z vf17, vf00                      ; vf17.z = 0
	nop[e]                           nop                                    ; upper: E-bit pad (END)

; -----------------------------------------------------------------------
; sub_2C00 - bone-blended vertex transform with clip-flag culling.
;
; Reads vi01 (VIF top), masks count in vi10, output base vi02 = vi01
; + 192.  Per-vertex loop blends two bones (vf18/vf21/vf20 source +
; vf04/vf03 dest), perspective-divides, ftoi4-converts, and stores
; one of two output paths based on clip-flag testing via fcand /
; fcor against a sequence of magic bit-masks at 0x2DB0..0x2E30.
;
; The clip-mask sequence (0xFDF7DF, 0xFEFBEF, 0xFF7DF7, 0xFFBEFB,
; 0xFFDF7D, 0xFFEFBE) progressively excludes one clip plane per
; iteration; if any of them indicate a fully-visible vertex (ibne
; fires), control falls into the L_1690 path which `bal vi15`s to
; the SCISSOR_COMMON_PUSHREGISTER save-context, L_08D8 hierarchical-driver, and SCISSOR_COMMON_POPREGISTER
; restore-context routines in sequence (effectively recursing into
; the LOD subdivider for that vertex), then `b SCISSOR_C_XYZ2` continues
; the per-vertex loop.  Otherwise (no fall-through), branches to
; SCISSOR_C_XYZ2 directly.
;
; Output kick: `xgkick vi02` + `b BEGIN_SCISSOR_C` returns to the init stub
; E-bit at 0x2BF8.
;
; Bundles 0x2CD8, 0x2CE0, 0x2CF0 are flag-bits-set FMACs (FD-dispatch
; .xyz variants) emitted via `.word`.
; -----------------------------------------------------------------------
	nop                              nop                                    ; (entry - also E-bit delay slot of BEGIN_SCISSOR_C)
START_SCISSOR_C:
	nop                              xtop vi01                              ; vi01 = VIF top
	nop                              ilwr.x vi10, (vi01)                    ; vi10 = *(int*)vi01 (count)
	nop                              iaddiu vi11, vi00, 32767               ; vi11 = 0x7FFF
	nop                              iand vi10, vi10, vi11                  ; vi10 &= 0x7FFF
	nop                              iaddi vi11, vi11, 1                    ; vi11 = 0x8000
	nop                              lq.xyzw vf25, 0(vi01)                  ; vf25 = mem[vi01] (header quad)
	nop                              iaddiu vi03, vi01, 1                   ; vi03 = vi01 + 1 (input cursor)
	nop                              iaddiu vi02, vi01, 192                 ; vi02 = vi01 + 192 (output base)
	nop                              sq.xyzw vf25, 0(vi02)                  ; store header
	nop                              iaddiu vi07, vi02, 1                   ; vi07 = vi02 + 1 (output cursor)
	mulw.xyzw vf22, vf00, vf00w      iaddi vi04, vi00, -2                   ; vf22 = 0; vi04 = -2
	mulw.xyzw vf23, vf00, vf00w      iaddi vi05, vi00, -2                   ; vf23 = 0; vi05 = -2
	mulw.xyzw vf24, vf00, vf00w      iaddi vi06, vi00, -2                   ; vf24 = 0; vi06 = -2
	nop                              lq.xyzw vf18, 0(vi03)                  ; preload vf18
	nop                              lq.xyzw vf21, 1(vi03)                  ; preload vf21
	nop                              lq.xyzw vf20, 2(vi03)                  ; preload vf20
	nop                              nop

SCISSOR_C_LOOP:
	mulax.xyzw acc, vf01, vf18x      move.xyzw vf22, vf23
	madday.xyzw acc, vf02, vf18y     move.xyzw vf23, vf24
	maddaz.xyzw acc, vf03, vf18z     iaddiu vi03, vi03, 3
	maddw.xyzw vf25, vf04, vf18w     iaddi vi10, vi10, -1
	sub.w       vf00, vf21, vf00     iadd vi04, vi00, vi05
	mulax.xyzw acc, vf13, vf18x      iadd vi05, vi00, vi06
	madday.xyzw acc, vf14, vf18y     nop
	maddaz.xyzw acc, vf15, vf18z     div q, vf00w, vf25w
	maddw.xyzw vf24, vf16, vf18w     fsand vi08, 0x2
	clipw.xyz vf22, vf22w            lq.xyzw vf18, 0(vi03)                  ; upper: op6=0x3F .xyz fd=7 fs=22 ft=22
	clipw.xyz vf23, vf23w            nop                                    ; upper: op6=0x3F .xyz fd=7 fs=23 ft=23
	add.xyz     vf28, vf21, vf17     nop
	clipw.xyz vf24, vf24w            lq.xyzw vf21, 1(vi03)                  ; upper: op6=0x3F .xyz fd=7 fs=24 ft=24
	ftoi0.xyzw  vf29, vf20           nop
	mulq.xyzw vf27, vf25, q          lq.xyzw vf20, 2(vi03)
	mulq.xyz vf28, vf28, q           nop
	nop                              fcand vi01, 0x3F                       ; vi01 = clip-flag bits 0..5
	nop                              sq.xyzw vf29, 1(vi07)                  ; store vf29
	ftoi4.xyzw  vf27, vf27           ibeq vi08, vi00, SCISSOR_C_CONT
	nop                              iadd vi06, vi00, vi01                  ; (delay slot) vi06 = clip bits
	nop                              iaddi vi04, vi00, 1
	nop                              iaddi vi05, vi00, 1
	nop                              iaddi vi09, vi00, 2
SCISSOR_C_CONT:
	nop                              iadd vi01, vi04, vi05
	nop                              iadd vi01, vi01, vi06
	nop                              sq.xyzw vf28, 0(vi07)
	nop                              ibgtz vi01, SCISSOR_C_XYZ3
	nop                              sq.xyzw vf27, 2(vi07)                  ; (delay slot)
SCISSOR_C_XYZ2:
	nop                              ibne vi10, vi00, SCISSOR_C_LOOP        ; loop while count != 0
	nop                              iaddiu vi07, vi07, 3                   ; (delay slot)
	nop                              xgkick vi02                            ; kick GIF packet
	nop                              nop
	nop                              b BEGIN_SCISSOR_C                      ; -> sub_2BC0 E-bit
	nop                              nop                                    ; (branch delay slot)
SCISSOR_C_XYZ3:
	nop                              iaddi vi09, vi09, -1
	nop                              ibgtz vi09, SCISSOR_C_XYZ3_ONLY
	nop                              fcor vi01, 0xFDF7DF
	nop                              ibne vi01, vi00, SCISSOR_C_XYZ3_ONLY
	nop                              nop
	nop                              fcor vi01, 0xFEFBEF
	nop                              ibne vi01, vi00, SCISSOR_C_XYZ3_ONLY
	nop                              nop
	nop                              fcor vi01, 0xFF7DF7
	nop                              ibne vi01, vi00, SCISSOR_C_XYZ3_ONLY
	nop                              nop
	nop                              fcor vi01, 0xFFBEFB
	nop                              ibne vi01, vi00, SCISSOR_C_XYZ3_ONLY
	nop                              nop
	nop                              fcor vi01, 0xFFDF7D
	nop                              ibne vi01, vi00, SCISSOR_C_XYZ3_ONLY
	nop                              nop
	nop                              fcor vi01, 0xFFEFBE
	nop                              ibne vi01, vi00, SCISSOR_C_XYZ3_ONLY
	nop                              nop
	nop                              bal vi15, SCISSOR_COMMON_PUSHREGISTER  ; save context
	nop                              nop
	nop                              bal vi15, SCISSOR_COMMON                       ; call LOD hierarchical driver
	nop                              nop
	nop                              bal vi15, SCISSOR_COMMON_POPREGISTER   ; restore context
	nop                              nop
SCISSOR_C_XYZ3_ONLY:
	nop                              b SCISSOR_C_XYZ2                       ; back into the per-vertex loop
	nop                              isw.w vi11, 2(vi07)                    ; (delay slot - also stores vi11.w)

; =======================================================================

; ico2/vusrc/mesh.vsm /* derived name */: the program text of vusrc/mesh.dsm.
;
; The program: the entry table, each `b` the entry of one routine; the
; routines every program carries (vu1_common.h); the matrix and light
; uploads; and the three mesh loops, lit, lit with specular and unlit.
;
; Entry table (bundle numbers from the start of the program):
;    0  SET_GSREGISTER          copy a counted run of quads, xgkick it
;    2  SET_UVOFFSET            mem[2].xy from the next input quad
;    8  SET_FONT_OFFSET         four input quads to mem[256..259]
;   10  START_DEBUG_FONT        debug-font quads, xgkick
;   12  SPACE_DEBUG_FONT        vf16.xy += vf17.xy
;   16  SET_MESH_MATRIX         vf01..vf04 from the input, vf14 constants
;   18  SET_MESH_LIGHT          vf05..vf12 from the input
;   20  BEGIN_MESH_NOLIGHT      unlit loop (START_MESH_NOLIGHT)
;   22  BEGIN_MESH_LIGHT        lit loop (START_MESH_LIGHT)
;   24  BEGIN_MESH_LIGHT_SPEC   lit loop with specular (START_MESH_LIGHT_SPEC)
; Bundles 4..7 and 14..15 hold nop.
;
; Each BEGIN_ routine ends the program at once (E-bit); the loop is the
; START_ routine after it. Each loop reads the vertex count from the
; first input word, transforms the vertices with vf01..vf04, writes the
; GIF packet after the input (vi01, vi03) and kicks it with xgkick vi01;
; END_ then branches back to the BEGIN_ routine. The CLIP_ labels pick
; the slot a vertex is written to from its clip flags.
;
;
; The I register carries two float constants for vf14, loaded with `loi`
; in SET_MESH_MATRIX: 16777214.0 (vf14.w) and 4094.0 (vf14.xy); the lit
; loops load 255.0 the same way for the colour clamp.
;
; The labels are the listing names (see the description in mesh.dsm).
;
; Program-2 entry-stub dispatch table.
;
	nop                              b SET_GSREGISTER                       ; 0x0DD0 - entry -> SET_GSREGISTER
	nop                              nop                                    ; delay slot
	nop                              b SET_UVOFFSET                         ; 0x0DE0 - entry -> SET_UVOFFSET
	nop                              nop                                    ; delay slot
	nop                              nop                                    ; 0x0DF0 - reserved slot
	nop                              nop                                    ; 0x0DF8 - reserved slot
	nop                              nop                                    ; 0x0E00 - reserved slot
	nop                              nop                                    ; 0x0E08 - reserved slot
	nop                              b SET_FONT_OFFSET                      ; 0x0E10 - entry -> SET_FONT_OFFSET
	nop                              nop                                    ; delay slot
	nop                              b START_DEBUG_FONT                     ; 0x0E20 - entry -> START_DEBUG_FONT
	nop                              nop                                    ; delay slot
	nop                              b SPACE_DEBUG_FONT                     ; 0x0E30 - entry -> SPACE_DEBUG_FONT
	nop                              nop                                    ; delay slot
	nop                              nop                                    ; 0x0E40 - reserved slot
	nop                              nop                                    ; 0x0E48 - reserved slot
	nop                              b SET_MESH_MATRIX                      ; 0x0E50 - entry -> SET_MESH_MATRIX
	nop                              nop                                    ; delay slot
	nop                              b SET_MESH_LIGHT                       ; 0x0E60 - entry -> SET_MESH_LIGHT
	nop                              nop                                    ; delay slot
	nop                              b BEGIN_MESH_NOLIGHT                             ; 0x0E70 - entry -> sub_15D8  (far-target)
	nop                              nop                                    ; delay slot
	nop                              b BEGIN_MESH_LIGHT                     ; 0x0E80 - entry -> BEGIN_MESH_LIGHT
	nop                              nop                                    ; delay slot
	nop                              b BEGIN_MESH_LIGHT_SPEC                ; 0x0E90 - entry -> BEGIN_MESH_LIGHT_SPEC
	nop                              nop                                    ; delay slot

; =======================================================================
; ROUTINES. The entry table above branches to each.
; =======================================================================

#include "vu1_common.h"

; -----------------------------------------------------------------------
; SET_MESH_MATRIX - I-register setup + 4-quad load.
;
; Loads two I-immediates into the VU0 I-register via the I-bit on a
; `pad`-upper bundle:
;   - 0x10C8: pad[I] + imm 0x4B7FFFFE (= IEEE-754 ~16777214.0;
;     used by `addi.w vf14, vf00` at 0x10D0 to set vf14.w).
;   - 0x10D8: pad[I] + imm 0x457FF000 (= IEEE-754 4094.0;
;     used by `addi.xy vf14, vf00` at 0x10E0 to set vf14.xy).
; Then loads vf01..vf04 from the vi13 stream.
;
; Both I-bundles are `loi` in the lower slot, the I-bit set on the
; upper.  A disassembler without I-bit tracking renders the lowers as
; `jalr vi31, vi31` (0x4B7FFFFE) and an op7=0x22 ".word" (0x457FF000)
; - both are immediate misreads.
; -----------------------------------------------------------------------
SET_MESH_MATRIX:
	nop                              xtop vi13
	nop                              loi 0x4b7ffffe                         ; pad[I] + I = 0x4B7FFFFE (~16777214.0f)
	addi.w vf14, vf00, i             move.xyzw vf13, vf00                   ; vf14.w = vf00.w + I (= 16777214.0); vf13 = 0
	nop                              loi 0x457ff000                         ; pad[I] + I = 0x457FF000 (= 4094.0f)
	addi.xy vf14, vf00, i            nop                                    ; vf14.xy = vf00.xy + I (= 4094.0)
	nop                              lqi.xyzw vf01, (vi13++)
	nop                              lqi.xyzw vf02, (vi13++)
	nop                              lqi.xyzw vf03, (vi13++)
	nop                              lqi.xyzw vf04, (vi13++)
	nop[e]                           nop                                    ; upper: E-bit pad (END)
	nop                              nop                                    ; E-bit delay slot

; -----------------------------------------------------------------------
; SET_MESH_LIGHT - bulk 8-quad load into vf05..vf12.  Variant of SET_CLUSTER_LIGHT (cluster)
; (program 1) at a different destination-register block.
; -----------------------------------------------------------------------
SET_MESH_LIGHT:
	nop                              xtop vi13
	nop                              lqi.xyzw vf05, (vi13++)
	nop                              lqi.xyzw vf06, (vi13++)
	nop                              lqi.xyzw vf07, (vi13++)
	nop                              lqi.xyzw vf08, (vi13++)
	nop                              lqi.xyzw vf09, (vi13++)
	nop                              lqi.xyzw vf10, (vi13++)
	nop                              lqi.xyzw vf11, (vi13++)
	nop                              lqi.xyzw vf12, (vi13++)
	nop[e]                           nop                                    ; upper: E-bit pad (END)
	nop                              nop                                    ; E-bit delay slot

; -----------------------------------------------------------------------
; BEGIN_MESH_LIGHT - 4-bundle shared terminator (TPC=0xE0 in program 2
; dispatch).  Same shape as sub_0A30: an extra `nop_swap` slot before
; the E-bit so the START_MESH_LIGHT loop tail `b BEGIN_MESH_LIGHT` lands one bundle
; ahead of the END.
; -----------------------------------------------------------------------
BEGIN_MESH_LIGHT:
	nop                              nop                                    ; do nothing (entry / branch delay slot)
	nop[e]                           nop                                    ; upper: E-bit pad (END)
	nop                              nop                                    ; E-bit delay slot

; -----------------------------------------------------------------------
; START_MESH_LIGHT - program-2 skinned vertex transform (variant 4).
;
; Same overall algorithm as START_CLUSTER_0 (cluster) (see that routine for full docs)
; with the following differences:
;   * Uses vi04 as the count register (not vi06) and vi05 as a 3-slot
;     decimator (not vi07).
;   * Output-base offset is +252 quads (not +192): `iaddiu vi01, vi13,
;     252`.  vi01 = vi13 + 252; output cursor vi03 = vi01 + 1.
;   * Lighting/color registers shuffled: front-face marker vf19
;     (not vf26), back-face marker vf20 (not vf27).
;   * Bone-weight register vf16 (not vf21/22); per-vertex matrix
;     selection via vf15/vf16/vf17/vf18.
;   * Loop start label is LOOP_MESH_LIGHT (= LOOP_MESH_LIGHT), reached after a
;     full pre-loop matrix-mul prologue.
;   * `iaddiu vi07, vi00, 208` sets the clip-mask in vi07 (not vi09).
;   * Bundle 0x12C8 is the I-bit 255.0f trick (upper `mul.xyz vf22,
;     vf18, vf29` + I-bit; lower 0x437F0000 -> I); disasm reads the
;     lower as `bal vi31, L_0510`, which is a misread.
;   * Loop tail: `b BEGIN_MESH_LIGHT` (into the 1-bundle pre-END at BEGIN_MESH_LIGHT).
; -----------------------------------------------------------------------
START_MESH_LIGHT:
	nop                              xtop vi13
	nop                              iaddiu vi14, vi00, 32767
	nop                              iaddiu vi02, vi13, 1
	nop                              ilwr.x vi04, (vi13)                    ; vi04 = count
	nop                              lq.xyzw vf29, 0(vi13)
	nop                              iand vi04, vi14, vi04
	nop                              iaddiu vi01, vi13, 252                 ; output base = vi13 + 252
	nop                              sq.xyzw vf29, 0(vi01)
	nop                              iaddiu vi14, vi14, 1
	nop                              iaddiu vi03, vi01, 1
	nop                              mfir.w vf19, vi00                      ; vf19.w = 0 (front-face marker)
	nop                              mfir.w vf20, vi14                      ; vf20.w = 0x8000 (back-face marker)
	nop                              iaddiu vi07, vi00, 208                 ; vi07 = clip mask 0xD0
	nop                              lqi.xyzw vf18, (vi02++)
	nop                              lq.xyzw vf23, 2(vi00)
	sub.w       vf21, vf21, vf21     lq.xyzw vf16, 1(vi02)                  ; vf21.w = 0; load weight quad
	nop                              lq.xyzw vf15, 0(vi02)
	nop                              lq.xyzw vf17, 2(vi02)
	nop                              iaddiu vi02, vi02, 3

	mulax.xyzw acc, vf05, vf16x      nop
	madday.xyzw acc, vf06, vf16y     nop
	maddaz.xyzw acc, vf07, vf16z     nop
	maddw.xyzw vf29, vf08, vf16w     nop
	mulax.xyzw acc, vf01, vf15x      nop
	madday.xyzw acc, vf02, vf15y     nop
	maddaz.xyzw acc, vf03, vf15z     nop
	maddw.xyzw vf28, vf04, vf00w     nop
	maxx.xyzw vf29, vf29, vf00x      nop
	add.xy      vf17, vf17, vf23     nop
	nop                              nop
	nop                              div q, vf00w, vf28w
	nop                              nop
	nop                              nop

LOOP_MESH_LIGHT:
	mulax.xyzw acc, vf09, vf29x      lqi.xyzw vf15, (vi02++)
	madday.xyzw acc, vf10, vf29y     lqi.xyzw vf16, (vi02++)
	maddaz.xyzw acc, vf11, vf29z     nop
	maddw.xyzw vf29, vf12, vf29w     iaddi vi04, vi04, -1
	mulq.xyz vf28, vf28, q           waitq
	mulq.xyz vf21, vf17, q           nop
	mulax.xyzw acc, vf01, vf15x      move.w vf22, vf18
; I-bit bundle: upper mul.xyz vf22,vf18,vf29 + I-bit; lower = 255.0f -> I
	mul.xyz vf22, vf18, vf29         loi 0x437f0000
	madday.xyzw acc, vf02, vf15y     lqi.xyzw vf17, (vi02++)
	ftoi4.xyz   vf19, vf28           sq.xyzw vf21, 0(vi03)
	ftoi4.xyz   vf20, vf28           nop
	minii.xyzw vf22, vf22, i         nop
	sub.xyw     vf00, vf13, vf28     nop
	sub.xyw     vf00, vf28, vf14     nop
	maddaz.xyzw acc, vf03, vf15z     nop
	ftoi0.xyzw  vf22, vf22           iaddi vi05, vi05, -1
	maddw.xyzw vf28, vf04, vf00w     fmand vi14, vi07
	mulax.xyzw acc, vf05, vf16x      fmand vi14, vi14
	madday.xyzw acc, vf06, vf16y     nop
	maddaz.xyzw acc, vf07, vf16z     ibne vi14, vi07, CLIP_MESH_LIGHT
	maddw.xyzw vf29, vf08, vf16w     sq.xyzw vf22, 1(vi03)
	nop                              ibgtz vi05, CLIP_MESH_LIGHT_SET
	nop                              sq.xyzw vf19, 2(vi03)
	nop                              b CLIP_MESH_LIGHT_END
	nop                              nop
CLIP_MESH_LIGHT:
	nop                              iaddiu vi05, vi00, 3
CLIP_MESH_LIGHT_SET:
	nop                              sq.xyzw vf20, 2(vi03)
CLIP_MESH_LIGHT_END:
	nop                              div q, vf00w, vf28w
	maxx.xyzw vf29, vf29, vf00x      ibne vi04, vi00, LOOP_MESH_LIGHT
	nop                              iaddiu vi03, vi03, 3
	nop                              xgkick vi01
END_MESH_LIGHT:
	nop                              b BEGIN_MESH_LIGHT
	nop                              nop                                    ; (branch delay slot)

; -----------------------------------------------------------------------
; BEGIN_MESH_LIGHT_SPEC - 3-bundle shared terminator (TPC=0xE0 dispatch via 0x0E90;
; also `b BEGIN_MESH_LIGHT_SPEC` from START_MESH_LIGHT_SPEC).  Same shape as BEGIN_CLUSTER_0 (cluster).
; -----------------------------------------------------------------------
BEGIN_MESH_LIGHT_SPEC:
	nop                              nop                                    ; do nothing (entry)
	nop[e]                           nop                                    ; upper: E-bit pad (END)
	nop                              nop                                    ; E-bit delay slot

; -----------------------------------------------------------------------
; START_MESH_LIGHT_SPEC - program-2 skinned vertex transform (variant 5).
;
; Near-clone of START_MESH_LIGHT with restructured loop body and a different
; placement of the I-bit immediate bundle (now at 0x1510 with the
; same `0x437F0000` = 255.0f I-immediate, upper `mul.xyz vf22, vf18,
; vf29` with I-bit).  Loop tail: `b BEGIN_MESH_LIGHT_SPEC`.
; -----------------------------------------------------------------------
START_MESH_LIGHT_SPEC:
	nop                              xtop vi13
	nop                              iaddiu vi14, vi00, 32767
	nop                              iaddiu vi02, vi13, 1
	nop                              ilwr.x vi04, (vi13)
	nop                              lq.xyzw vf29, 0(vi13)
	nop                              iand vi04, vi14, vi04
	nop                              iaddiu vi01, vi13, 252
	nop                              sq.xyzw vf29, 0(vi01)
	nop                              iaddiu vi14, vi14, 1
	nop                              iaddiu vi03, vi01, 1
	nop                              mfir.w vf19, vi00
	nop                              mfir.w vf20, vi14
	nop                              iaddiu vi07, vi00, 208
	nop                              lqi.xyzw vf18, (vi02++)
	nop                              lq.xyzw vf23, 2(vi00)
	sub.w       vf21, vf21, vf21     lq.xyzw vf16, 1(vi02)
	nop                              lq.xyzw vf15, 0(vi02)
	nop                              lq.xyzw vf17, 2(vi02)
	nop                              iaddiu vi02, vi02, 3

	mulax.xyzw acc, vf05, vf16x      nop
	madday.xyzw acc, vf06, vf16y     nop
	maddaz.xyzw acc, vf07, vf16z     nop
	maddw.xyzw vf29, vf08, vf16w     nop
	mulax.xyzw acc, vf01, vf15x      nop
	madday.xyzw acc, vf02, vf15y     nop
	maddaz.xyzw acc, vf03, vf15z     nop
	maddw.xyzw vf28, vf04, vf00w     nop
	maxx.xyzw vf29, vf29, vf00x      nop
	add.xy      vf17, vf17, vf23     nop
	nop                              nop
	nop                              div q, vf00w, vf28w
	nop                              nop
	nop                              nop

LOOP_MESH_LIGHT_SPEC:
	mulax.xyzw acc, vf09, vf29x      iaddi vi04, vi04, -1
	madday.xyzw acc, vf10, vf29y     lqi.xyzw vf15, (vi02++)
	maddaz.xyzw acc, vf11, vf29z     lqi.xyzw vf16, (vi02++)
	maddw.xyzw vf29, vf12, vf29w     nop
	mulq.xyz vf28, vf28, q           waitq
	mulq.xyz vf21, vf17, q           nop
	mulax.xyzw acc, vf01, vf15x      lqi.xyzw vf17, (vi02++)
	mul.xyz     vf29, vf29, vf29     nop                                    ; vf29^2
	ftoi4.xyz   vf19, vf28           move.w vf22, vf18
	ftoi4.xyz   vf20, vf28           sq.xyzw vf21, 0(vi03)
	sub.xyw     vf00, vf13, vf28     nop
; I-bit bundle: upper mul.xyz vf22,vf18,vf29 + I-bit; lower = 255.0f -> I
	mul.xyz vf22, vf18, vf29         loi 0x437f0000
	sub.xyw     vf00, vf28, vf14     nop
	madday.xyzw acc, vf02, vf15y     nop
	maddaz.xyzw acc, vf03, vf15z     fmand vi14, vi07
	minii.xyzw vf22, vf22, i         nop
	maddw.xyzw vf28, vf04, vf00w     fmand vi14, vi14
	mulax.xyzw acc, vf05, vf16x      nop
	madday.xyzw acc, vf06, vf16y     nop
	ftoi0.xyzw  vf22, vf22           iaddi vi05, vi05, -1
	maddaz.xyzw acc, vf07, vf16z     div q, vf00w, vf28w
	maddw.xyzw vf29, vf08, vf16w     nop
	add.xy      vf17, vf17, vf23     ibne vi14, vi07, CLIP_MESH_LIGHT_SPEC
	nop                              sq.xyzw vf22, 1(vi03)
	nop                              ibgtz vi05, CLIP_MESH_LIGHT_SPEC_SET
	nop                              sq.xyzw vf19, 2(vi03)
	nop                              b CLIP_MESH_LIGHT_SPEC_END
	nop                              nop
CLIP_MESH_LIGHT_SPEC:
	nop                              iaddiu vi05, vi00, 3
CLIP_MESH_LIGHT_SPEC_SET:
	nop                              sq.xyzw vf20, 2(vi03)
CLIP_MESH_LIGHT_SPEC_END:
	maxx.xyzw vf29, vf29, vf00x      iaddiu vi03, vi03, 3
	nop                              ibne vi04, vi00, LOOP_MESH_LIGHT_SPEC
	nop                              nop                                    ; (branch delay slot)
	nop                              xgkick vi01
END_MESH_LIGHT_SPEC:
	nop                              b BEGIN_MESH_LIGHT_SPEC

; -----------------------------------------------------------------------
; sub_15D8 - 4-bundle shared terminator with extra `nop_swap` at
; BEGIN_MESH_NOLIGHT (so START_MESH_NOLIGHT can `b BEGIN_MESH_NOLIGHT` and hit the E-bit one bundle
; later).  Same shape as sub_0A30 / BEGIN_MESH_LIGHT.
; -----------------------------------------------------------------------
#line LN(323, 323, 323, 323, 323, 318, 323) ""
	nop                              nop                                    ; do nothing (entry / branch delay slot)
BEGIN_MESH_NOLIGHT:
	nop                              nop                                    ; START_MESH_NOLIGHT `b BEGIN_MESH_NOLIGHT` lands here
	nop[e]                           nop                                    ; upper: E-bit pad (END)
	nop                              nop                                    ; E-bit delay slot

; -----------------------------------------------------------------------
; START_MESH_NOLIGHT - program-2 skinned vertex transform (variant 6).
;
; Near-clone of START_MESH_LIGHT_SPEC with one additional `move.w vf29, vf28` /
; `ftoi0.xyzw vf22, vf18` bundle at LOOP_MESH_NOLIGHT, and a different loop-exit
; pattern that branches to BEGIN_MESH_NOLIGHT (one bundle past sub_15D8 entry)
; for the END.
; -----------------------------------------------------------------------
START_MESH_NOLIGHT:
	nop                              xtop vi13
#line LN(339, 339, 339, 339, 339, 327, 339) ""
	nop                              iaddiu vi14, vi00, 32767
	nop                              iaddiu vi02, vi13, 1
	nop                              ilwr.x vi04, (vi13)
	nop                              lq.xyzw vf29, 0(vi13)
	nop                              iand vi04, vi14, vi04
	nop                              iaddiu vi01, vi13, 252
	nop                              sq.xyzw vf29, 0(vi01)
	nop                              iaddiu vi14, vi14, 1
	nop                              iaddiu vi03, vi01, 1
	nop                              mfir.w vf19, vi00
	nop                              mfir.w vf20, vi14
	nop                              iaddiu vi07, vi00, 208
	nop                              lqi.xyzw vf18, (vi02++)
	nop                              lq.xyzw vf23, 2(vi00)
	sub.w       vf21, vf21, vf21     lqi.xyzw vf15, (vi02++)
	nop                              lqi.xyzw vf17, (vi02++)
	nop                              nop
	nop                              nop

	mulax.xyzw acc, vf01, vf15x      nop
	madday.xyzw acc, vf02, vf15y     nop
	maddaz.xyzw acc, vf03, vf15z     nop
	maddw.xyzw vf28, vf04, vf00w     nop
	nop                              lqi.xyzw vf15, (vi02++)
	nop                              nop
	nop                              nop
	add.xy      vf17, vf17, vf23     div q, vf00w, vf28w

LOOP_MESH_NOLIGHT:
	ftoi0.xyzw  vf22, vf18           move.w vf29, vf28
	mulq.xyz vf29, vf28, q           waitq
	mulq.xyz vf21, vf17, q           iaddi vi05, vi05, -1
	mulax.xyzw acc, vf01, vf15x      lqi.xyzw vf17, (vi02++)
	madday.xyzw acc, vf02, vf15y     sq.xyzw vf22, 1(vi03)
	sub.xyw     vf00, vf13, vf29     iaddi vi04, vi04, -1
	sub.xyw     vf00, vf29, vf14     sq.xyzw vf21, 0(vi03)
	maddaz.xyzw acc, vf03, vf15z     nop
	maddw.xyzw vf28, vf04, vf00w     lqi.xyzw vf15, (vi02++)
	ftoi4.xyz   vf19, vf29           fmand vi14, vi07
	ftoi4.xyz   vf20, vf29           fmand vi14, vi14
	add.xy      vf17, vf17, vf23     ibne vi14, vi07, CLIP_MESH_NOLIGHT
	nop                              div q, vf00w, vf28w
	nop                              ibgtz vi05, CLIP_MESH_NOLIGHT_SET
	nop                              sq.xyzw vf19, 2(vi03)
	nop                              b CLIP_MESH_NOLIGHT_END
	nop                              nop
CLIP_MESH_NOLIGHT:
	nop                              iaddiu vi05, vi00, 3
CLIP_MESH_NOLIGHT_SET:
	nop                              sq.xyzw vf20, 2(vi03)
CLIP_MESH_NOLIGHT_END:
	nop                              iaddiu vi03, vi03, 3
	nop                              ibne vi04, vi00, LOOP_MESH_NOLIGHT
	nop                              nop                                    ; (branch delay slot)
	nop                              xgkick vi01
END_MESH_NOLIGHT:
	nop                              b BEGIN_MESH_NOLIGHT
	nop                              nop                                    ; (branch delay slot)

; =======================================================================
; THIRD VU0 PROGRAM begins here.  Same multi-program concatenation as
; the program-1 -> program-2 transition at 0x0DB0.
; =======================================================================

; Program-3 pre-header filler (one bundle of true-zero halves) +
; control-flag prologue (parallels program 2 0x0DB0..0x0DC8 with a
; different FCSET immediate).

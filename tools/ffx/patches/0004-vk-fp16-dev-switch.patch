diff --git a/sdk/src/backends/vk/ffx_vk.cpp b/sdk/src/backends/vk/ffx_vk.cpp
--- a/sdk/src/backends/vk/ffx_vk.cpp
+++ b/sdk/src/backends/vk/ffx_vk.cpp
@@ -26,6 +26,7 @@
 #include <FidelityFX/host/backends/vk/ffx_vk.h>
 #include <ffx_shader_blobs.h>
 #include <ffx_breadcrumbs_list.h>
+#include <cstdlib>
 
 #ifdef _WIN32
 #include <windows.h>
@@ -2113,6 +2114,15 @@
         }
     }
 
+    // the ICO port's [dev] fsr3_fp16 = off (ICO_RD_FSR3_FP16=0 or off; port/render/rd_fsr3.c):
+    // the context is made as on a device without fp16, so every pass takes its fp32
+    // permutation (issue 203: the vertical lines under FSR 3.1 on a GTX 1660)
+    {
+        const char* fp16 = getenv("ICO_RD_FSR3_FP16");
+        if (fp16 && (strcmp(fp16, "0") == 0 || strcmp(fp16, "off") == 0))
+            deviceCapabilities->fp16Supported = false;
+    }
+
     return FFX_OK;
 }
 

@@ -49,3 +50,59 @@ std::wstring UTF8ToWChar(const std::string& str)
 
     return wstr;
 }
+#else
+// POSIX: wchar_t is UTF-32.
+std::string WCharToUTF8(const std::wstring& wstr)
+{
+    std::string str;
+    for (wchar_t wc : wstr)
+    {
+        uint32_t c = static_cast<uint32_t>(wc);
+        if (c < 0x80)
+            str += static_cast<char>(c);
+        else if (c < 0x800)
+        {
+            str += static_cast<char>(0xC0 | (c >> 6));
+            str += static_cast<char>(0x80 | (c & 0x3F));
+        }
+        else if (c < 0x10000)
+        {
+            str += static_cast<char>(0xE0 | (c >> 12));
+            str += static_cast<char>(0x80 | ((c >> 6) & 0x3F));
+            str += static_cast<char>(0x80 | (c & 0x3F));
+        }
+        else
+        {
+            str += static_cast<char>(0xF0 | (c >> 18));
+            str += static_cast<char>(0x80 | ((c >> 12) & 0x3F));
+            str += static_cast<char>(0x80 | ((c >> 6) & 0x3F));
+            str += static_cast<char>(0x80 | (c & 0x3F));
+        }
+    }
+    return str;
+}
+
+std::wstring UTF8ToWChar(const std::string& str)
+{
+    std::wstring wstr;
+    for (size_t i = 0; i < str.size();)
+    {
+        unsigned char b = static_cast<unsigned char>(str[i]);
+        uint32_t      c;
+        size_t        n;
+        if (b < 0x80)
+            c = b, n = 1;
+        else if ((b & 0xE0) == 0xC0)
+            c = b & 0x1F, n = 2;
+        else if ((b & 0xF0) == 0xE0)
+            c = b & 0x0F, n = 3;
+        else
+            c = b & 0x07, n = 4;
+        for (size_t k = 1; k < n && i + k < str.size(); ++k)
+            c = (c << 6) | (static_cast<unsigned char>(str[i + k]) & 0x3F);
+        wstr += static_cast<wchar_t>(c);
+        i += n;
+    }
+    return wstr;
+}
+#endif

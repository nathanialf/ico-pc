diff --git a/sdk/src/backends/vk/ffx_vk.cpp b/sdk/src/backends/vk/ffx_vk.cpp
--- a/sdk/src/backends/vk/ffx_vk.cpp
+++ b/sdk/src/backends/vk/ffx_vk.cpp
@@ -26,6 +26,7 @@
 #include <FidelityFX/host/backends/vk/ffx_vk.h>
 #include <ffx_shader_blobs.h>
 #include <ffx_breadcrumbs_list.h>
+#include <cstdlib>
 
 #ifdef _WIN32
 #include <windows.h>
@@ -2113,6 +2114,16 @@
         }
     }
 
+    // the ICO port runs the upscaler in full precision on every device (issue 203: thin
+    // vertical lines from the fp16 maths on a GTX 1660): fp16 is reported only when the
+    // port's [dev] fsr3_fp16 = on exports ICO_RD_FSR3_FP16=1 (or on); port/render/rd_fsr3.c
+    // rd__fsr3_fp16_dev_on reads the same variable for its lines
+    {
+        const char* fp16 = getenv("ICO_RD_FSR3_FP16");
+        if (!fp16 || (strcmp(fp16, "1") != 0 && strcmp(fp16, "on") != 0))
+            deviceCapabilities->fp16Supported = false;
+    }
+
     return FFX_OK;
 }
 

{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-host/${presetName}",
            "environment": {
                "PATH": "${sourceDir}/.venv/bin:$penv{PATH}"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "ICO_HEADLESS": "ON"
            }
        },
        {
            "name": "ref-m32",
            "inherits": "base",
            "displayName": "Linux i386 reference, GCC",
            "toolchainFile": "${sourceDir}/cmake/toolchains/i686-linux-gcc.cmake"
        },
        {
            "name": "win-x86-ref",
            "inherits": "base",
            "displayName": "Windows 32-bit reference, mingw-w64 GCC",
            "toolchainFile": "${sourceDir}/cmake/toolchains/i686-w64-mingw32-gcc.cmake",
            "cacheVariables": {
                "ICO_HEADLESS": "OFF"
            }
        },
        {
            "name": "linux-x64",
            "inherits": "base",
            "displayName": "Linux x86-64, host GCC",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc"
            }
        },
        {
            "name": "win-x64",
            "inherits": "base",
            "displayName": "Windows x64, mingw-w64 GCC",
            "toolchainFile": "${sourceDir}/cmake/toolchains/x86_64-w64-mingw32-gcc.cmake",
            "cacheVariables": {
                "ICO_HEADLESS": "OFF"
            }
        },
        {
            "name": "asan",
            "inherits": "base",
            "displayName": "Linux x86-64, AddressSanitizer + UBSan, host GCC",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_FLAGS_DEBUG": "-g -O1",
                "ICO_SANITIZE": "address,undefined"
            }
        },
        {
            "name": "fptrap",
            "inherits": "linux-x64",
            "displayName": "Linux x86-64, float divide-by-zero and invalid trap",
            "cacheVariables": {
                "ICO_FPTRAP": "ON"
            }
        },
        {
            "name": "ref-m32-clang",
            "inherits": "base",
            "displayName": "Linux i386 reference, llvm-mingw clang",
            "toolchainFile": "${sourceDir}/cmake/toolchains/i686-linux-clang.cmake",
            "description": "Clang family: the game's GNU nested functions do not compile with clang (docs/port/BUILD_STATUS.md)."
        },
        {
            "name": "win-x86-ref-clang",
            "inherits": "base",
            "displayName": "Windows 32-bit reference, llvm-mingw clang",
            "toolchainFile": "${sourceDir}/cmake/toolchains/i686-w64-mingw32.cmake",
            "description": "Clang family: the game's GNU nested functions do not compile with clang (docs/port/BUILD_STATUS.md)."
        },
        {
            "name": "linux-x64-clang",
            "inherits": "base",
            "displayName": "Linux x86-64, llvm-mingw clang",
            "toolchainFile": "${sourceDir}/cmake/toolchains/x86_64-linux-clang.cmake",
            "description": "Clang family: the game's GNU nested functions do not compile with clang (docs/port/BUILD_STATUS.md)."
        },
        {
            "name": "win-x64-clang",
            "inherits": "base",
            "displayName": "Windows x64, llvm-mingw clang",
            "toolchainFile": "${sourceDir}/cmake/toolchains/x86_64-w64-mingw32.cmake",
            "description": "Clang family: the game's GNU nested functions do not compile with clang (docs/port/BUILD_STATUS.md)."
        }
    ],
    "buildPresets": [
        {
            "name": "ref-m32",
            "configurePreset": "ref-m32"
        },
        {
            "name": "win-x86-ref",
            "configurePreset": "win-x86-ref"
        },
        {
            "name": "linux-x64",
            "configurePreset": "linux-x64"
        },
        {
            "name": "win-x64",
            "configurePreset": "win-x64"
        },
        {
            "name": "asan",
            "configurePreset": "asan"
        },
        {
            "name": "fptrap",
            "configurePreset": "fptrap"
        },
        {
            "name": "ref-m32-clang",
            "configurePreset": "ref-m32-clang"
        },
        {
            "name": "win-x86-ref-clang",
            "configurePreset": "win-x86-ref-clang"
        },
        {
            "name": "linux-x64-clang",
            "configurePreset": "linux-x64-clang"
        },
        {
            "name": "win-x64-clang",
            "configurePreset": "win-x64-clang"
        }
    ],
    "testPresets": [
        {
            "name": "ref-m32",
            "configurePreset": "ref-m32",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-x64",
            "configurePreset": "linux-x64",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "asan",
            "configurePreset": "asan",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "fptrap",
            "configurePreset": "fptrap",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "ref-m32-clang",
            "configurePreset": "ref-m32-clang",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-x64-clang",
            "configurePreset": "linux-x64-clang",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}

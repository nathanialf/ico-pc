{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-host/${presetName}",
            "environment": {
                "PATH": "${sourceDir}/.venv/bin:$penv{PATH}"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "ICO_HEADLESS": "ON"
            }
        },
        {
            "name": "linux-x64",
            "inherits": "base",
            "displayName": "Linux x86-64, host GCC",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc"
            }
        },
        {
            "name": "linux-arm64",
            "inherits": "base",
            "displayName": "Linux arm64 (aarch64), host GCC",
            "description": "Built on an arm64 Linux host (no cross toolchain). Window build with the program linked, Vulkan only: no Direct3D 12 and no DXIL shaders.",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "ICO_HEADLESS": "OFF",
                "ICO_LINK_EXE": "ON",
                "ICO_RHI_D3D12": "OFF",
                "ICO_SHADERS_DXIL": "OFF"
            }
        },
        {
            "name": "win-x64",
            "inherits": "base",
            "displayName": "Windows x64, mingw-w64 GCC",
            "toolchainFile": "${sourceDir}/cmake/toolchains/x86_64-w64-mingw32-gcc.cmake",
            "cacheVariables": {
                "ICO_HEADLESS": "OFF"
            }
        },
        {
            "name": "asan",
            "inherits": "linux-x64",
            "displayName": "Linux x86-64, AddressSanitizer + UBSan, host GCC",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_FLAGS_DEBUG": "-g -O1",
                "ICO_SANITIZE": "address,undefined"
            }
        },
        {
            "name": "fptrap",
            "inherits": "linux-x64",
            "displayName": "Linux x86-64, float divide-by-zero and invalid trap",
            "cacheVariables": {
                "ICO_FPTRAP": "ON"
            }
        },
        {
            "name": "linux-x64-clang",
            "inherits": "base",
            "displayName": "Linux x86-64, llvm-mingw clang",
            "toolchainFile": "${sourceDir}/cmake/toolchains/x86_64-linux-clang.cmake",
            "description": "Clang family: builds the same sources as the gcc presets (docs/BUILDING.md, \"Compilers\")."
        },
        {
            "name": "win-x64-clang",
            "inherits": "base",
            "displayName": "Windows x64, llvm-mingw clang",
            "toolchainFile": "${sourceDir}/cmake/toolchains/x86_64-w64-mingw32.cmake",
            "description": "Clang family: builds the same sources as the gcc presets (docs/BUILDING.md, \"Compilers\")."
        },
        {
            "name": "android-arm64",
            "inherits": "base",
            "displayName": "Android arm64-v8a, NDK clang (libmain.so)",
            "toolchainFile": "${sourceDir}/cmake/toolchains/android-arm64.cmake",
            "description": "Compile check of the Android build without Gradle; tools/fetch_android.sh first. The APK is built by android/ (Gradle) with the same cache variables.",
            "cacheVariables": {
                "ICO_HEADLESS": "OFF",
                "ICO_LINK_EXE": "ON",
                "ICO_RHI_D3D12": "OFF",
                "ICO_SHADERS_DXIL": "OFF"
            }
        },
        {
            "name": "ios-moltenvk",
            "inherits": "base",
            "displayName": "iOS ARM64 Vulkan through MoltenVK (renderer libraries)",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_SYSTEM_NAME": "iOS",
                "CMAKE_OSX_SYSROOT": "iphoneos",
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
                "ICO_HEADLESS": "OFF",
                "ICO_LINK_EXE": "OFF",
                "ICO_RHI_VULKAN": "ON",
                "ICO_RHI_MOLTENVK": "ON",
                "ICO_RHI_D3D12": "OFF",
                "ICO_SHADERS_DXIL": "OFF"
            }
        },
        {
            "name": "macos-moltenvk",
            "inherits": "base",
            "displayName": "macOS ARM64 Vulkan through MoltenVK (renderer libraries)",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_SYSTEM_NAME": "Darwin",
                "CMAKE_OSX_SYSROOT": "macosx",
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0",
                "ICO_HEADLESS": "OFF",
                "ICO_LINK_EXE": "OFF",
                "ICO_RHI_VULKAN": "ON",
                "ICO_RHI_MOLTENVK": "ON",
                "ICO_RHI_D3D12": "OFF",
                "ICO_SHADERS_DXIL": "OFF"
            }
        },
        {
            "name": "ios-app",
            "inherits": "ios-moltenvk",
            "displayName": "ICO iOS app (unsigned, ARM64)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ICO_LINK_EXE": "ON",
                "ICO_DXC": "${sourceDir}/tools/toolchain/deps/dxc-build/bin/dxc"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-x64",
            "configurePreset": "linux-x64"
        },
        {
            "name": "linux-arm64",
            "configurePreset": "linux-arm64"
        },
        {
            "name": "win-x64",
            "configurePreset": "win-x64"
        },
        {
            "name": "asan",
            "configurePreset": "asan"
        },
        {
            "name": "fptrap",
            "configurePreset": "fptrap"
        },
        {
            "name": "linux-x64-clang",
            "configurePreset": "linux-x64-clang"
        },
        {
            "name": "win-x64-clang",
            "configurePreset": "win-x64-clang"
        },
        {
            "name": "android-arm64",
            "configurePreset": "android-arm64",
            "targets": ["ico_pc"]
        },
        {
            "name": "ios-moltenvk",
            "configurePreset": "ios-moltenvk",
            "targets": ["ico_rhi"]
        },
        {
            "name": "macos-moltenvk",
            "configurePreset": "macos-moltenvk",
            "targets": ["ico_rhi"]
        },
        {
            "name": "ios-app",
            "configurePreset": "ios-app",
            "targets": ["ico_pc"]
        }
    ],
    "testPresets": [
        {
            "name": "linux-x64",
            "configurePreset": "linux-x64",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-arm64",
            "configurePreset": "linux-arm64",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "asan",
            "configurePreset": "asan",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "fptrap",
            "configurePreset": "fptrap",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-x64-clang",
            "configurePreset": "linux-x64-clang",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
